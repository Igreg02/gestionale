    align-items: center;
    justify-content: center;
    color: var(--text-muted);
    transition: background 0.15s, color 0.15s;
}

.admin-row-icon-btn:hover {
    background: var(--bg-light);
    color: var(--primary-blue);
}

.admin-row-icon-btn.is-danger:hover {
    color: #dc2626;
}

.admin-row-icon-btn:disabled {
    opacity: 0.5;
    cursor: not-allowed;
}

.admin-table thead th {
    text-align: left;
    padding: 0.85rem 1.25rem;
    background: var(--bg-light);
    color: var(--text-muted);
    font-weight: 700;
    font-size: 0.78rem;
    text-transform: uppercase;
    letter-spacing: 0.03em;
    border-bottom: 1px solid var(--border-color);
}

.admin-table tbody td {
    padding: 0.85rem 1.25rem;
    border-bottom: 1px solid var(--border-color);
    color: var(--text-dark);
    vertical-align: middle;
}

.admin-table tbody tr:last-child td {
    border-bottom: none;
}

.admin-table tbody tr:hover {
    background: var(--bg-light);
}

.admin-table-actions {
    display: flex;
    gap: 0.5rem;
    justify-content: flex-end;
}

.admin-empty-row td {
    text-align: center;
    color: var(--text-muted);
    padding: 2.5rem 1rem;
}

.admin-row-icon-btn {
    border: none;
    background: transparent;
    width: 32px;
    height: 32px;
    border-radius: 8px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    color: var(--text-muted);
    transition:  0.15s, color 0.15s;
}

.admin-row-icon-btn:hover {
    background: var(--bg-light);
    color: var(--primary-blue);
}

.admin-row-icon-btn.is-danger:hover {
    color: #dc2626;
}

.admin-row-icon-btn:disabled {
    opacity: 0.5;
    cursor: not-allowed;
}
