<div class="container-fluid px-4">
    <Row Class="mb-4">
        <Column ColumnSize="ColumnSize.Is12">
            <h2 class="dashboard-title">@Title</h2>
            <p class="dashboard-subtitle">@Subtitle</p>
        </Column>
    </Row>

    <Row>
        <Column ColumnSize="ColumnSize.Is12">
            <div class="placeholder-panel">
                <div class="icon-circle bg-light-blue mb-3">
                    <i class="@IconCss text-blue"></i>
                </div>
                <h5 class="mb-2">Sezione in arrivo</h5>
                <p class="text-muted mb-2">Il modulo verrà implementato nella @PhaseLabel della roadmap.</p>
                <p class="text-muted small mb-0">Navigazione e permessi per ruolo sono già attivi da questa fase (F3).</p>
            </div>
        </Column>
    </Row>
</div>

@code {
    /// <summary>Titolo della pagina (es. "I miei Worklog").</summary>
    [Parameter, EditorRequired] public string Title { get; set; } = string.Empty;

    /// <summary>Sottotitolo descrittivo sotto il titolo.</summary>
    [Parameter, EditorRequired] public string Subtitle { get; set; } = string.Empty;

    /// <summary>Classe icona Bootstrap Icons (es. "bi bi-journal-text").</summary>
    [Parameter] public string IconCss { get; set; } = "bi bi-hourglass-split";

    /// <summary>Etichetta della fase roadmap che implementerà il contenuto reale (es. "Fase F5").</summary>
    [Parameter, EditorRequired] public string PhaseLabel { get; set; } = string.Empty;
}
