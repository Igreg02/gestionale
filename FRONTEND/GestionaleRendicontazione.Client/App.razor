<CascadingAuthenticationState>
    <Router AppAssembly="@typeof(App).Assembly">
        <Found Context="routeData">
            <AuthorizeRouteView RouteData="@routeData" DefaultLayout="@typeof(MainLayout)">
                <NotAuthorized>
                    @if (context.User.Identity is { IsAuthenticated: true })
                    {
                        <!-- Utente autenticato ma senza il ruolo richiesto dalla route: 403, non login. -->
                        <Forbidden />
                    }
                    else
                    {
                        <!-- Utente anonimo su una route protetta: redirect automatico al login. -->
                        <RedirectToLogin />
                    }
                </NotAuthorized>
                <Authorizing>
                    <div class="p-5 text-center">
                        <Heading Size="HeadingSize.Is4">Verifica autenticazione...</Heading>
                    </div>
                </Authorizing>
            </AuthorizeRouteView>
            <FocusOnNavigate RouteData="@routeData" Selector="h1" />
        </Found>
        <NotFound>
            <PageTitle>Pagina non trovata</PageTitle>
            <LayoutView Layout="@typeof(MainLayout)">
                <AuthorizeView>
                    <Authorized>
                        <!-- Utente autenticato su un URL inesistente: torna alla Dashboard. -->
                        <RedirectToDashboard />
                    </Authorized>
                    <NotAuthorized>
                        <!-- Utente anonimo su un URL inesistente: non deve poter uscire dal login. -->
                        <RedirectToLogin />
                    </NotAuthorized>
                </AuthorizeView>
            </LayoutView>
        </NotFound>
    </Router>
</CascadingAuthenticationState>
