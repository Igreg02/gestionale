                <div class="alert alert-danger py-2 px-3 mx-0 mb-0" style="font-size:0.88rem; border-radius:0; margin-top:-1px;">
                    <i class="bi bi-exclamation-triangle me-1"></i> @_modalError
                </div>
            }

            <div class="wl-modal-body">
                <div class="wl-modal-left">

                    @if (_isAdmin)
                    {
                        <div class="wl-field-row">
                            <label class="wl-field-label">Dipendente</label>
                            <select class="wl-field-input" @bind="_editModel.IdEmployee">
                                <option value="@Guid.Empty">-- Seleziona --</option>
                                @foreach (var emp in _employees)
                                {
                                    <option value="@emp.Id">@emp.Username (@emp.FirstName @emp.LastName)</option>
                                }
                            </select>
