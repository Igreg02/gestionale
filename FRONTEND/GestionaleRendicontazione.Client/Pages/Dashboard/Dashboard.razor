                                <option value="@t.Id">@t.Name</option>
                            }
                        </select>
                    </div>

                    <div class="wl-field-row">
                        <label class="wl-field-label">Stato</label>
                        <select class="wl-field-input" @bind="_editModel.IdStatus">
                            <option value="@Guid.Empty">-- Seleziona --</option>
                            @foreach (var s in _statuses)
                            {
                                <option value="@s.Id">@s.Name</option>
                            }
                        </select>
                    </div>

                </div>

                <div class="wl-modal-right">
                    <label class="wl-field-label mb-2">Descrizione</label>
                    <textarea class="wl-desc-area" rows="8"
                              @bind="_editModel.Description"
                              placeholder="Descrivi l'attività svolta..."></textarea>
                </div>
            </div>

            <div class="wl-modal-footer">
                <button class="wl-btn-delete" @onclick="() => { CloseEditModal(); ConfirmDelete(_editSource!); }" disabled="@_isSaving">
                    <i class="bi bi-trash3 me-1"></i> Elimina
                </button>
                <div class="d-flex gap-2">
                    <button class="wl-btn-cancel" @onclick="CloseEditModal" disabled="@_isSaving">
                        Annulla
                    </button>
                    <button class="wl-btn-save" @onclick="SaveEditAsync" disabled="@_isSaving">
                        @if (_isSaving)
                        {
                            <i class="bi bi-arrow-repeat spin"></i> <span>Salvataggio...</span>
                        }
                        else
                        {
                            <i class="bi bi-check2"></i> <span>Salva</span>
                        }
                    </button>
                </div>
            </div>

        </div>
    </div>
}

@* ====================== MODALE CONFERMA ELIMINA ====================== *@
@if (_deleteModalOpen && _deleteTarget is not null)
{
    <div class="custom-modal-backdrop" @onclick="CloseDeleteModal">
        <div class="wl-modal-card" style="max-width:440px;" @onclick:stopPropagation="true">

            <div class="wl-modal-header">
                <span class="wl-modal-label" style="color:#dc2626;">ELIMINA WORKLOG</span>
                <div class="d-flex align-items-center gap-3">
                    <button class="wl-back-btn" @onclick="CloseDeleteModal" aria-label="Chiudi">
                        <i class="bi bi-arrow-left"></i>
                    </button>
                    <span class="wl-modal-title">Conferma eliminazione</span>
                </div>
            </div>

            <div class="wl-modal-body" style="display:block; padding:1.5rem;">
                <p class="mb-2" style="font-size:0.95rem;">Stai per eliminare il worklog:</p>
                <div style="background:var(--bg-light); border-radius:10px; padding:0.75rem 1rem; margin-bottom:0.75rem;">
                    <strong>@_deleteTarget.ProjectName</strong>
                    <span class="ms-2 text-muted" style="font-size:0.85rem;">@_deleteTarget.Date.ToString("dd/MM/yyyy")</span><br />
                    <span class="text-muted" style="font-size:0.85rem;">@_deleteTarget.Description</span>
                </div>
                @if (_modalError is not null)
                {
                    <div class="alert alert-danger py-2 px-3 mb-2" style="font-size:0.88rem; border-radius:10px;">
                        <i class="bi bi-exclamation-triangle me-1"></i> @_modalError
                    </div>
                }
                <p class="text-muted mb-0" style="font-size:0.88rem;">Questa operazione non può essere annullata.</p>
            </div>

            <div class="wl-modal-footer">
                <div></div>
                <div class="d-flex gap-2">
                    <button class="wl-btn-cancel" @onclick="CloseDeleteModal" disabled="@_isSaving">
                        Annulla
                    </button>
                    <button class="wl-btn-delete wl-btn-delete--solid" @onclick="ExecuteDeleteAsync" disabled="@_isSaving">
                        @if (_isSaving)
                        {
                            <i class="bi bi-arrow-repeat spin"></i> <span>Eliminazione...</span>
                        }
                        else
                        {
                            <i class="bi bi-trash3 me-1"></i> <span>Conferma elimina</span>
                        }
                    </button>
                </div>
            </div>

        </div>
    </div>
}

@code {
    [CascadingParameter] private Task<AuthenticationState>? AuthStateTask { get; set; }

    private static readonly (string Icon, string Background, string Text)[] _iconPalette =
    {
        ("bi bi-clipboard-data", "bg-light-blue", "text-blue"),
        ("bi bi-code-slash", "bg-light-green", "text-green"),
        ("bi bi-gear", "bg-light-orange", "text-orange"),
        ("bi bi-journal-text", "bg-light-blue", "text-blue"),
        ("bi bi-people", "bg-light-green", "text-green"),
    };

    private string _displayName = string.Empty;
    private bool _loading = true;
    private string? _errorMessage;
    private List<WorkLogResponseDto> _worklogs = new();
    private bool _isAdmin;
    private DateOnly _periodFrom;
    private DateOnly _periodTo;
    private string _periodLabel => $"{_periodFrom:dd/MM/yyyy} – {_periodTo:dd/MM/yyyy}";

    // --- Filtri (periodo + admin: dipendente/progetto/stato) ---
    private string _filterFromString = string.Empty;
    private string _filterToString = string.Empty;
    private Guid _filterEmployeeId = Guid.Empty;
    private Guid _filterProjectId = Guid.Empty;
    private string _filterStatusName = string.Empty;

    // --- Lookup lists per i dropdown ---
    private List<ProjectResponseDto> _projects = new();
    private List<StatusResponseDto> _statuses = new();
    private List<TypeResponseDto> _types = new();
    private List<EmployeeResponseDto> _employees = new();

    // --- Create modal ---
    private bool _createModalOpen;
    private WorkLogUpdateRequestDto? _createModel;
    private string _createDateString = string.Empty;

    // --- Edit modal ---
    private bool _editModalOpen;
    private WorkLogResponseDto? _editSource;
    private WorkLogUpdateRequestDto? _editModel;
    private string _editDateString = string.Empty;

    // --- Delete modal ---
    private bool _deleteModalOpen;
    private WorkLogResponseDto? _deleteTarget;

    // --- Shared ---
    private bool _isSaving;
    private string? _modalError;

    protected override async Task OnInitializedAsync()
    {
        if (AuthStateTask is not null)
        {
            var authState = await AuthStateTask;
            _displayName = authState.User.FindFirst("display_name")?.Value ?? authState.User.Identity?.Name ?? string.Empty;
            _isAdmin = authState.User.IsInRole(RoleNames.Admin);
        }

        var today = DateOnly.FromDateTime(DateTime.Today);
        _periodFrom = new DateOnly(today.Year, today.Month, 1);
        _periodTo = _periodFrom.AddMonths(1).AddDays(-1);
        _filterFromString = _periodFrom.ToString("yyyy-MM-dd");
        _filterToString = _periodTo.ToString("yyyy-MM-dd");

        await Task.WhenAll(LoadWorklogsAsync(), LoadLookupsAsync());
    }

    /// <summary>
    /// Recupera i worklog del mese corrente da GET /api/worklog: con token User il backend filtra
    /// sul dipendente autenticato, con token Admin restituisce quelli di tutti.
    /// </summary>
    private async Task LoadWorklogsAsync()
    {
        _loading = true;
        _errorMessage = null;
        StateHasChanged();

        try
        {
            var result = await WorkLogApiClient.GetAsync(
                _periodFrom,
                _periodTo,
                _isAdmin && _filterEmployeeId != Guid.Empty ? _filterEmployeeId : null,
                _isAdmin && _filterProjectId != Guid.Empty ? _filterProjectId : null,
                _isAdmin && !string.IsNullOrWhiteSpace(_filterStatusName) ? _filterStatusName : null);
            _worklogs = result
                .OrderByDescending(w => w.Date)
                .ThenByDescending(w => w.CreateAt)
                .ToList();
        }
        catch (Exception ex)
        {
            Console.Error.WriteLine($"Errore nel recupero dei worklog: {ex}");
            _errorMessage = "Impossibile recuperare i worklog dal server. Riprova più tardi.";
        }
        finally
        {
            _loading = false;
        }
    }

    // ==============================
    // Filtri (periodo, dipendente, progetto, stato)
    // ==============================

    private void OnFilterFromInput(ChangeEventArgs e)
    {
        _filterFromString = e.Value?.ToString() ?? string.Empty;
        if (DateOnly.TryParseExact(_filterFromString, "yyyy-MM-dd", null, DateTimeStyles.None, out var parsed))
        {
            _periodFrom = parsed;
        }
    }

    private void OnFilterToInput(ChangeEventArgs e)
    {
        _filterToString = e.Value?.ToString() ?? string.Empty;
        if (DateOnly.TryParseExact(_filterToString, "yyyy-MM-dd", null, DateTimeStyles.None, out var parsed))
        {
            _periodTo = parsed;
        }
    }

    private async Task ApplyFiltersAsync()
    {
        if (_periodFrom > _periodTo)
        {
            _errorMessage = "L'intervallo di date non è valido: 'Dal' deve precedere 'Al'.";
            return;
        }

        await LoadWorklogsAsync();
    }

    private async Task ResetFiltersAsync()
    {
        var today = DateOnly.FromDateTime(DateTime.Today);
        _periodFrom = new DateOnly(today.Year, today.Month, 1);
        _periodTo = _periodFrom.AddMonths(1).AddDays(-1);
        _filterFromString = _periodFrom.ToString("yyyy-MM-dd");
        _filterToString = _periodTo.ToString("yyyy-MM-dd");
        _filterEmployeeId = Guid.Empty;
        _filterProjectId = Guid.Empty;
        _filterStatusName = string.Empty;

        await LoadWorklogsAsync();
    }

    private async Task LoadLookupsAsync()
    {
        try
        {
            var projTask = WorkLogApiClient.GetProjectsAsync();
            var statusTask = WorkLogApiClient.GetStatusesAsync();
            var typeTask = WorkLogApiClient.GetTypesAsync();

            if (_isAdmin)
            {
                var empTask = WorkLogApiClient.GetEmployeesAsync();
                await Task.WhenAll(projTask, statusTask, typeTask, empTask);
                _employees = await empTask;
            }
            else
            {
                await Task.WhenAll(projTask, statusTask, typeTask);
            }

            _projects = await projTask;
            _statuses = await statusTask;
            _types = await typeTask;
        }
        catch (Exception ex)
        {
            Console.Error.WriteLine($"Errore nel recupero dei dati di supporto: {ex}");
        }
    }

    // ==============================
    // Create Modal
    // ==============================

    private void OpenCreateModal()
    {
        _modalError = null;
        var today = DateOnly.FromDateTime(DateTime.Today);
        _createModel = new WorkLogUpdateRequestDto
        {
            Date = today,
            HoursCounter = 8,
            IdEmployee = Guid.Empty,
            IdProject = Guid.Empty,
            IdType = Guid.Empty,
            IdStatus = Guid.Empty,
        };
        _createDateString = today.ToString("yyyy-MM-dd");
        _createModalOpen = true;
    }

    private void CloseCreateModal()
    {
        _createModalOpen = false;
        _createModel = null;
        _modalError = null;
    }

    private void OnCreateDateInput(ChangeEventArgs e)
    {
        _createDateString = e.Value?.ToString() ?? string.Empty;
        if (_createModel is not null &&
            DateOnly.TryParseExact(_createDateString, "yyyy-MM-dd", null, System.Globalization.DateTimeStyles.None, out var parsed))
        {
            _createModel.Date = parsed;
        }
    }

    private async Task SaveCreateAsync()
    {
        if (_createModel is null) return;

        if (string.IsNullOrWhiteSpace(_createModel.Description)) { _modalError = "La descrizione è obbligatoria."; return; }
        if (_createModel.HoursCounter < 1 || _createModel.HoursCounter > 24) { _modalError = "Le ore devono essere comprese tra 1 e 24."; return; }
        if (_createModel.IdProject == Guid.Empty) { _modalError = "Seleziona un progetto."; return; }
        if (_createModel.IdType == Guid.Empty) { _modalError = "Seleziona una tipologia."; return; }
        if (_createModel.IdStatus == Guid.Empty) { _modalError = "Seleziona uno stato."; return; }
        if (_isAdmin && _createModel.IdEmployee == Guid.Empty) { _modalError = "Seleziona un dipendente."; return; }

        _isSaving = true;
        _modalError = null;

        try
        {
            var created = await WorkLogApiClient.CreateAsync(_createModel);
            if (created is null) { _modalError = "Errore durante la creazione. Riprova più tardi."; return; }

            _worklogs.Insert(0, created);
            CloseCreateModal();
        }
        catch (Exception ex)
        {
            Console.Error.WriteLine($"Errore POST worklog: {ex}");
            _modalError = "Errore di rete. Riprova più tardi.";
        }
        finally
        {
            _isSaving = false;
        }
    }

    // ==============================
    // Edit Modal
    // ==============================

    private void OpenEditModal(WorkLogResponseDto worklog)
    {
        _editSource = worklog;
        _modalError = null;
        _editModel = new WorkLogUpdateRequestDto
        {
            Description = worklog.Description,
            HoursCounter = worklog.HoursCounter,
            Date = worklog.Date,
            IdProject = worklog.IdProject,
            IdEmployee = worklog.IdEmployee ?? Guid.Empty,
            IdType = worklog.IdType,
            IdStatus = worklog.IdStatus,
        };
        _editDateString = worklog.Date.ToString("yyyy-MM-dd");
        _editModalOpen = true;
    }

    private void CloseEditModal()
    {
        _editModalOpen = false;
        _editSource = null;
        _editModel = null;
        _modalError = null;
    }

    private void OnDateInput(ChangeEventArgs e)
    {
        _editDateString = e.Value?.ToString() ?? string.Empty;
        if (_editModel is not null &&
            DateOnly.TryParseExact(_editDateString, "yyyy-MM-dd", null, System.Globalization.DateTimeStyles.None, out var parsed))
        {
            _editModel.Date = parsed;
        }
    }

    private async Task SaveEditAsync()
    {
        if (_editModel is null || _editSource is null) return;

        if (string.IsNullOrWhiteSpace(_editModel.Description)) { _modalError = "La descrizione è obbligatoria."; return; }
        if (_editModel.HoursCounter < 1 || _editModel.HoursCounter > 24) { _modalError = "Le ore devono essere comprese tra 1 e 24."; return; }
        if (_editModel.IdProject == Guid.Empty) { _modalError = "Seleziona un progetto."; return; }
        if (_editModel.IdType == Guid.Empty) { _modalError = "Seleziona una tipologia."; return; }
        if (_editModel.IdStatus == Guid.Empty) { _modalError = "Seleziona uno stato."; return; }
        if (_isAdmin && _editModel.IdEmployee == Guid.Empty) { _modalError = "Seleziona un dipendente."; return; }

        // Per utenti normali il backend ignora IdEmployee
        if (!_isAdmin)
            _editModel.IdEmployee = _editSource.IdEmployee ?? Guid.Empty;

        _isSaving = true;
        _modalError = null;

        try
        {
            var updated = await WorkLogApiClient.UpdateAsync(_editSource.Id, _editModel);
            if (updated is null) { _modalError = "Errore durante il salvataggio. Riprova più tardi."; return; }

            var idx = _worklogs.FindIndex(w => w.Id == updated.Id);
            if (idx >= 0) _worklogs[idx] = updated;

            CloseEditModal();
        }
        catch (Exception ex)
        {
            Console.Error.WriteLine($"Errore PUT worklog: {ex}");
            _modalError = "Errore di rete. Riprova più tardi.";
        }
        finally
        {
            _isSaving = false;
        }
    }

    // ==============================
    // Delete Modal
    // ==============================

    private void ConfirmDelete(WorkLogResponseDto worklog)
    {
        _deleteTarget = worklog;
        _modalError = null;
        _deleteModalOpen = true;
    }

    private void CloseDeleteModal()
    {
        _deleteModalOpen = false;
        _deleteTarget = null;
        _modalError = null;
    }

    private async Task ExecuteDeleteAsync()
    {
        if (_deleteTarget is null) return;

        _isSaving = true;
        _modalError = null;

        try
        {
            var ok = await WorkLogApiClient.DeleteAsync(_deleteTarget.Id);
            if (!ok) { _modalError = "Impossibile eliminare il worklog. Riprova più tardi."; return; }

            _worklogs.RemoveAll(w => w.Id == _deleteTarget.Id);
            CloseDeleteModal();
        }
        catch (Exception ex)
        {
            Console.Error.WriteLine($"Errore DELETE worklog: {ex}");
            _modalError = "Errore di rete. Riprova più tardi.";
        }
        finally
        {
            _isSaving = false;
        }
    }

    private static string FormatHours(float hours)
    {
        var formatted = hours.ToString("0.##", CultureInfo.InvariantCulture).Replace('.', ',');
        return $"{formatted} ore";
    }
}
