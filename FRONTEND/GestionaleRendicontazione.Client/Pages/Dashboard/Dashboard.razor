@page "/"
@attribute [Authorize]
@using System.Globalization
@using System.Security.Claims
@using GestionaleRendicontazione.Client.Services
@implements IDisposable
@inject WorkLogApiClient WorkLogApiClient
@inject FilterStateService FilterState

<PageTitle>Dashboard</PageTitle>

<div class="container-fluid px-4">

    <Row class="mb-4">
        <Column ColumnSize="ColumnSize.Is12">
            <div class="d-flex align-items-center justify-content-between flex-wrap gap-3">
                <div>
                    <h2 class="dashboard-title mb-1">I miei Worklog</h2>
                    <p class="dashboard-subtitle mb-0">Consulta, modifica ed elimina le tue rendicontazioni ore</p>
                </div>
            </div>
        </Column>
    </Row>

    <Row class="mb-4">
        <Column ColumnSize="ColumnSize.Is12">
            @if (FilterState.Loading)
            {
                <div class="worklog-status-panel">
                    <i class="bi bi-arrow-repeat spin"></i> Caricamento worklog...
                </div>
            }
            else if (_errorMessage is not null)
            {
                <Alert Color="Color.Danger" Visible="true">@_errorMessage</Alert>
            }
            else
            {
                <div class="worklog-grid">
                    @{ var visibleWorklogs = FilteredWorklogs.ToList(); }
                    @if (visibleWorklogs.Count == 0)
                    {
                        <div class="worklog-empty">
                            <i class="bi bi-inbox"></i>
                            @if (!string.IsNullOrWhiteSpace(FilterState.SearchQuery))
                            {
                                <p class="mb-0">Nessun worklog corrisponde alla ricerca "@FilterState.SearchQuery".</p>
                            }
                            else
                            {
                                <p class="mb-0">Nessun worklog registrato nel periodo @_periodLabel.</p>
                            }
                        </div>
                    }
                    else
                    {
                        @foreach (var item in visibleWorklogs.Select((w, i) => (Worklog: w, Index: i)))
                        {
                            var palette = _iconPalette[item.Index % _iconPalette.Length];
                            <div class="worklog-card">
                                <div class="worklog-card-body d-flex flex-column justify-content-between h-100">
                                    <div>
                                        <div class="d-flex align-items-center mb-3">
                                            <div class="icon-circle @palette.Background">
                                                <i class="@palette.Icon @palette.Text"></i>
                                            </div>
                                            <div class="ms-3">
                                                <h5 class="worklog-id" title="@item.Worklog.ProjectName">@item.Worklog.ProjectName</h5>
                                                <span class="worklog-date">@item.Worklog.Date.ToString("dd/MM/yyyy")</span>
                                            </div>
                                        </div>
                                        @if (FilterState.IsAdmin && item.Worklog.EmployeeName is not null)
                                        {
                                            <div class="d-flex align-items-center gap-1 mb-2">
                                                <i class="bi bi-person-fill text-muted" style="font-size:0.8rem;"></i>
                                                <span style="font-size:0.82rem; color:var(--text-muted); font-weight:600;">@item.Worklog.EmployeeName</span>
                                            </div>
                                        }
                                        <p class="worklog-description text-muted mb-2" title="@item.Worklog.Description">@item.Worklog.Description</p>
                                        <div class="worklog-hours text-blue fw-bold">@FormatHours(item.Worklog.HoursCounter)</div>
                                        <span class="worklog-status-badge">@item.Worklog.StatusName</span>
                                    </div>
                                    <div class="d-flex align-items-center justify-content-between mt-3">
                                        <button class="btn-visualizza text-blue d-inline-flex align-items-center gap-1 border-0 bg-transparent p-0"
                                                @onclick="() => OpenEditModal(item.Worklog)">
                                            <i class="bi bi-pencil-square"></i> Modifica
                                        </button>
                                        <button class="btn-elimina d-inline-flex align-items-center gap-1 border-0 bg-transparent p-0"
                                                @onclick="() => ConfirmDelete(item.Worklog)"
                                                disabled="@_isSaving">
                                            <i class="bi bi-trash3"></i> Elimina
                                        </button>
                                    </div>
                                </div>
                            </div>
                        }
                    }

                    <button class="worklog-card card-placeholder-new" @onclick="OpenCreateModal">
                        <div class="worklog-card-body d-flex flex-column align-items-center justify-content-center h-100 py-4">
                            <div class="icon-circle bg-light-blue mb-2">
                                <i class="bi bi-plus-lg text-blue" style="font-size: 1.5rem;"></i>
                            </div>
                            <span class="fw-bold text-blue">Nuovo Worklog</span>
                        </div>
                    </button>
                </div>
            }
        </Column>
    </Row>

    <Row class="mt-4">
        <Column ColumnSize="ColumnSize.Is12">
            <div class="report-panel">
                <div class="report-header mb-4 d-flex align-items-center">
                    <div class="icon-report-circle me-2">
                        <i class="bi bi-bar-chart-line text-blue"></i>
                    </div>
                    <h4 class="report-title m-0">Report</h4>
                </div>

                <div class="d-flex flex-column flex-md-row align-items-md-end gap-3">
                    <div class="flex-grow-1" style="min-width: 150px;">
                        <label class="form-label text-muted fw-bold small">Periodo da</label>
                        <div class="input-group">
                            <input type="date" class="form-control custom-input" value="@_periodFrom.ToString("yyyy-MM-dd")" />
                            </div>
                    </div>
                    <div class="flex-grow-1" style="min-width: 150px;">
                        <label class="form-label text-muted fw-bold small">Periodo a</label>
                        <div class="input-group">
                            <input type="date" class="form-control custom-input" value="@_periodTo.ToString("yyyy-MM-dd")" />
                        </div>
                    </div>
                    <AuthorizeView Roles="@RoleNames.Admin">
            <div class="flex-grow-1" style="min-width: 200px;">
                <label class="form-label text-muted fw-bold small">Dipendente</label>
                <select class="form-select custom-input">
                    @if (_employeesLoading)
                    {
                        <option disabled>Caricamento...</option>
                    }
                    else
                    {
                        @foreach (var emp in _employees)
                        {
                            <option value="@emp.Id">@emp.Username (@emp.FirstName @emp.LastName)</option>
                        }
                    }
                        </select>
                    </div>
            </AuthorizeView>
                    <div class="flex-grow-1" style="min-width: 180px;">
                        <NavLink href="/report" class="btn btn-primary w-100 btn-genera d-flex align-items-center justify-content-center gap-2">
                            <i class="bi bi-bar-chart-line-fill"></i> Genera Report
                        </NavLink>
                    </div>
                </div>
            </div>
    </Column>
    </Row>
</div>

@* ====================== MODALE CREA WORKLOG ====================== *@
@if (_createModalOpen && _createModel is not null)
{
    <div class="custom-modal-backdrop" @onclick="CloseCreateModal">
        <div class="wl-modal-card" @onclick:stopPropagation="true">
            <div class="wl-modal-header">
                <span class="wl-modal-label">NUOVO WORKLOG</span>
                <div class="d-flex align-items-center gap-3">
                    <button class="wl-back-btn" @onclick="CloseCreateModal" aria-label="Chiudi"><i class="bi bi-arrow-left"></i></button>
                    <span class="wl-modal-title">Nuovo Worklog</span>
                </div>
            </div>

            @if (_modalError is not null)
            {
                <div class="alert alert-danger py-2 px-3 mx-0 mb-0" style="font-size:0.88rem; border-radius:0; margin-top:-1px;">
                    <i class="bi bi-exclamation-triangle me-1"></i> @_modalError
                </div>
            }

            <div class="wl-modal-body">
                <div class="wl-modal-left">
                    @if (FilterState.IsAdmin)
                    {
                        <div class="wl-field-row">
                            <label class="wl-field-label">Dipendente</label>
                            <select class="wl-field-input" @bind="_createModel.IdEmployee">
                                <option value="@Guid.Empty">-- Seleziona --</option>
                                @if (_employeesLoading)
                                {
                                    <option disabled>Caricamento...</option>
                                }
                                else
                                {
                                    @foreach (var emp in _employees)
                                    {
                                        <option value="@emp.Id">@emp.Username (@emp.FirstName @emp.LastName)</option>
                                    }
                                }
                            </select>
                        </div>
                    }

                    <div class="wl-field-row">
                        <label class="wl-field-label">Data</label>
                        <input type="date" class="wl-field-input" value="@_createDateString" @oninput="OnCreateDateInput" />
                    </div>

                    <div class="wl-field-row">
                        <label class="wl-field-label">Ore</label>
                        <input type="number" class="wl-field-input" min="1" max="24" step="0.5" @bind="_createModel.HoursCounter" />
                    </div>

                    <div class="wl-field-row">
                        <label class="wl-field-label">Progetto</label>
                        <select class="wl-field-input" @bind="_createModel.IdProject">
                            <option value="@Guid.Empty">-- Seleziona --</option>
                            @foreach (var proj in FilterState.Projects)
                            {
                                <option value="@proj.Id">@proj.Name</option>
                            }
                        </select>
                    </div>

                    <div class="wl-field-row">
                        <label class="wl-field-label">Tipo</label>
                        <select class="wl-field-input" @bind="_createModel.IdType">
                            <option value="@Guid.Empty">-- Seleziona --</option>
                            @foreach (var t in _types)
                            {
                                <option value="@t.Id">@t.Name</option>
                            }
                        </select>
                    </div>

                    <div class="wl-field-row">
                        <label class="wl-field-label">Stato</label>
                        <select class="wl-field-input" @bind="_createModel.IdStatus">
                            <option value="@Guid.Empty">-- Seleziona --</option>
                            @foreach (var s in FilterState.Statuses)
                            {
                                <option value="@s.Id">@s.Name</option>
                            }
                        </select>
                    </div>
                </div>

                <div class="wl-modal-right">
                    <label class="wl-field-label mb-2">Descrizione</label>
                    <textarea class="wl-desc-area" rows="8" @bind="_createModel.Description" placeholder="Descrivi l'attività svolta..."></textarea>
                </div>
            </div>

            <div class="wl-modal-footer">
                <div></div>
                <div class="d-flex gap-2">
                    <button class="wl-btn-cancel" @onclick="CloseCreateModal" disabled="@_isSaving">Annulla</button>
                    <button class="wl-btn-save" @onclick="SaveCreateAsync" disabled="@_isSaving">
                        @if (_isSaving) { <i class="bi bi-arrow-repeat spin"></i> <span>Salvataggio...</span> }
                        else { <i class="bi bi-check2"></i> <span>Salva</span> }
                    </button>
                </div>
            </div>
        </div>
    </div>
}

@* ====================== MODALE MODIFICA WORKLOG ====================== *@
