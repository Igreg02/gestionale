@page "/"
@attribute [Authorize]

<PageTitle>Dashboard</PageTitle>

<div class="container-fluid px-4">
    <Row Class="mb-4">
        <Column ColumnSize="ColumnSize.Is12">
            <h2 class="dashboard-title">Dashboard</h2>
            <p class="dashboard-subtitle">Benvenuto Mario Rossi</p>
            <button class="btn btn-primary btn-new-worklog mt-3 d-inline-flex align-items-center gap-2">
                <i class="bi bi-plus-lg"></i> Nuovo Worklog
            </button>
        </Column>
    </Row>

    <Row class="mb-4">
        <Column ColumnSize="ColumnSize.Is12">
            <div class="worklog-grid">
                
                <div class="worklog-card">
                    <div class="worklog-card-body d-flex flex-column justify-content-between h-100">
                        <div>
                            <div class="d-flex align-items-center mb-3">
                                <div class="icon-circle bg-light-blue">
                                    <i class="bi bi-clipboard-data text-blue"></i>
                                </div>
                                <div class="ms-3">
                                    <h5 class="worklog-id">Worklog #1001</h5>
                                    <span class="worklog-date">16/07/2026</span>
                                </div>
                            </div>
                            <div class="worklog-hours text-blue fw-bold">8 ore</div>
                        </div>
                        <div class="text-end mt-3">
                            <a href="#" class="btn-visualizza text-blue d-inline-flex align-items-center gap-1">
                                Visualizza <i class="bi bi-arrow-right"></i>
                            </a>
                        </div>
                    </div>
                </div>

                <div class="worklog-card">
                    <div class="worklog-card-body d-flex flex-column justify-content-between h-100">
                        <div>
                            <div class="d-flex align-items-center mb-3">
                                <div class="icon-circle bg-light-green">
                                    <i class="bi bi-code-slash text-green"></i>
                                </div>
                                <div class="ms-3">
                                    <h5 class="worklog-id">Worklog #1002</h5>
                                    <span class="worklog-date">15/07/2026</span>
                                </div>
                            </div>
                            <div class="worklog-hours text-blue fw-bold">6 ore</div>
                        </div>
                        <div class="text-end mt-3">
                            <a href="#" class="btn-visualizza text-blue d-inline-flex align-items-center gap-1">
                                Visualizza <i class="bi bi-arrow-right"></i>
                            </a>
                        </div>
                    </div>
                </div>

                <div class="worklog-card">
                    <div class="worklog-card-body d-flex flex-column justify-content-between h-100">
                        <div>
                            <div class="d-flex align-items-center mb-3">
                                <div class="icon-circle bg-light-orange">
                                    <i class="bi bi-gear text-orange"></i>
                                </div>
                                <div class="ms-3">
                                    <h5 class="worklog-id">Worklog #1003</h5>
                                    <span class="worklog-date">14/07/2026</span>
                                </div>
                            </div>
                            <div class="worklog-hours text-blue fw-bold">4 ore</div>
                        </div>
                        <div class="text-end mt-3">
                            <a href="#" class="btn-visualizza text-blue d-inline-flex align-items-center gap-1">
                                Visualizza <i class="bi bi-arrow-right"></i>
                            </a>
                        </div>
                    </div>
                </div>

                <div class="worklog-card card-placeholder-new">
                    <div class="worklog-card-body d-flex flex-column align-items-center justify-content-center h-100 py-4">
                        <div class="icon-circle bg-light-blue mb-2">
                            <i class="bi bi-plus-lg text-blue" style="font-size: 1.5rem;"></i>
                        </div>
                        <span class="fw-bold text-blue">Nuovo Worklog</span>
                    </div>
                </div>

            </div>
        </Column>
    </Row>

    <Row class="mt-4">
        <Column ColumnSize="ColumnSize.Is12">
            <div class="report-panel">
                <div class="report-header mb-4 d-flex align-items-center">
                    <div class="icon-report-circle me-2">
                        <i class="bi bi-bar-chart-line text-blue"></i>
                    </div>
                    <h4 class="report-title m-0">Report</h4>
                </div>
                
                <div class="row align-items-end g-3">
                    <div class="col-12 col-md-3">
                        <label class="form-label text-muted fw-bold small">Periodo da</label>
                        <div class="input-group">
                            <input type="text" class="form-control custom-input" value="01/07/2026" />
                            <span class="input-group-text custom-input-icon bg-light"><i class="bi bi-calendar3"></i></span>
                        </div>
                    </div>
                    <div class="col-12 col-md-3">
                        <label class="form-label text-muted fw-bold small">Periodo a</label>
                        <div class="input-group">
                            <input type="text" class="form-control custom-input" value="31/07/2026" />
                            <span class="input-group-text custom-input-icon bg-light"><i class="bi bi-calendar3"></i></span>
                        </div>
                    </div>
                    <div class="col-12 col-md-3">
                        <label class="form-label text-muted fw-bold small">Dipendente</label>
                        <select class="form-select custom-input">
                            <option>Me (Mario Rossi)</option>
                        </select>
                    </div>
                    <div class="col-12 col-md-3">
                        <button class="btn btn-primary w-100 btn-genera d-flex align-items-center justify-content-center gap-2">
                            <i class="bi bi-bar-chart-line-fill"></i> Genera Report
                        </button>
                    </div>
                </div>
            </div>
        </Column>
    </Row>
</div>