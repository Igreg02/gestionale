@page "/"
@attribute [Authorize]
@using GestionaleRendicontazione.Client.Pages.Dashboard.Components
@inject WorkLogApiClient WorkLogApiClient
@inject FilterStateService FilterState

<PageTitle>Dashboard</PageTitle>

<div class="container-fluid px-4">

    <Row class="mb-4">
        <Column ColumnSize="ColumnSize.Is12">
            <div class="d-flex align-items-center justify-content-between flex-wrap gap-3">
                <div>
                    <h2 class="dashboard-title mb-1">I miei Worklog</h2>
                    <p class="dashboard-subtitle mb-0">Consulta, modifica ed elimina le tue rendicontazioni ore</p>
                </div>
            </div>
        </Column>
    </Row>

    <WorklogGrid Loading="FilterState.Loading"
                ErrorMessage="@_errorMessage"
                Worklogs="FilteredWorklogs"
                SearchQuery="@FilterState.SearchQuery"
                PeriodLabel="@_periodLabel"
                IsSaving="_isSaving"
                OnRetry="() => LoadWorklogsAsync()"
                OnEdit="OpenEditModal"
                OnDelete="ConfirmDelete"
                OnCreate="OpenCreateModal" />

    <ReportPanel Loading="FilterState.Loading" OnGenerateReport="OpenReportModal" />
</div>

<WorklogCreateModal Open="_createModalOpen"
                    Model="_createModel"
                    DateString="@_createDateString"
                    Employees="_employees"
                    EmployeesLoading="_employeesLoading"
                    Types="_types"
                    ModalError="@_modalError"
                    IsSaving="_isSaving"
                    OnClose="CloseCreateModal"
                    OnDateInput="OnCreateDateInput"
                    OnSave="SaveCreateAsync" />

<WorklogEditModal Open="_editModalOpen"
                    Model="_editModel"
                    EditSource="_editSource"
                    DateString="@_editDateString"
                    Employees="_employees"
                    EmployeesLoading="_employeesLoading"
                    Types="_types"
                    ModalError="@_modalError"
                    IsSaving="_isSaving"
                    OnClose="CloseEditModal"
                    OnDateInput="OnDateInput"
                    OnSave="SaveEditAsync"
                    OnDeleteRequest="ConfirmDelete" />

<WorklogDeleteModal Open="_deleteModalOpen"
                    Target="_deleteTarget"
                    ModalError="@_modalError"
                    IsSaving="_isSaving"
                    OnClose="CloseDeleteModal"
                    OnConfirm="ExecuteDeleteAsync" />

@* ====================== MODALE REPORT / DOWNLOAD PDF ====================== *@
<ReportDownloadModal Visible="_reportModalOpen"
                    GeneratedBy="@_displayName"
                    OnClose="CloseReportModal" />