
@if (Open && Model is not null && EditSource is not null)
{
    <div class="custom-modal-backdrop" @onclick="() => OnClose.InvokeAsync()">
        <div class="wl-modal-card" @onclick:stopPropagation="true">
            <div class="wl-modal-header">
                <span class="wl-modal-label">MODIFICA WORKLOG</span>
                <div class="d-flex align-items-center gap-3">
                    <button class="wl-back-btn" @onclick="() => OnClose.InvokeAsync()" aria-label="Chiudi"><i class="bi bi-arrow-left"></i></button>
                    <span class="wl-modal-title">Worklog — @EditSource.ProjectName</span>
                </div>
            </div>

            @if (ModalError is not null)
            {
                <div class="alert alert-danger py-2 px-3 mx-0 mb-0" style="font-size:0.88rem; border-radius:0; margin-top:-1px;">
                    <i class="bi bi-exclamation-triangle me-1"></i> @ModalError
                </div>
            }

            <div class="wl-modal-body">
                <WorklogFormFields Model="Model"
                                    DateString="@DateString"
                                    OnDateInput="OnDateInput"
                                    Employees="Employees"
                                    EmployeesLoading="EmployeesLoading"
                                    Types="Types" />
            </div>

            <div class="wl-modal-footer">
                <button class="wl-btn-delete" @onclick="HandleDeleteClick" disabled="@IsSaving">
                    <i class="bi bi-trash3 me-1"></i> Elimina
                </button>
                <div class="d-flex gap-2">
                    <button class="wl-btn-cancel" @onclick="() => OnClose.InvokeAsync()" disabled="@IsSaving">Annulla</button>
                    <button class="wl-btn-save" @onclick="() => OnSave.InvokeAsync()" disabled="@IsSaving">
                        @if (IsSaving) { <i class="bi bi-arrow-repeat spin"></i> <span>Salvataggio...</span> }
                        else { <i class="bi bi-check2"></i> <span>Salva</span> }
                    </button>
                </div>
            </div>
        </div>
    </div>
}

@code {
    [Parameter] public bool Open { get; set; }
    [Parameter] public WorkLogUpdateRequestDto? Model { get; set; }
    [Parameter] public WorkLogResponseDto? EditSource { get; set; }
    [Parameter] public string DateString { get; set; } = string.Empty;
    [Parameter] public List<EmployeeResponse> Employees { get; set; } = new();
    [Parameter] public bool EmployeesLoading { get; set; }
    [Parameter] public List<WorkTypeResponse> Types { get; set; } = new();
    [Parameter] public string? ModalError { get; set; }
    [Parameter] public bool IsSaving { get; set; }
    [Parameter] public EventCallback OnClose { get; set; }
    [Parameter] public EventCallback<ChangeEventArgs> OnDateInput { get; set; }
    [Parameter] public EventCallback OnSave { get; set; }
    [Parameter] public EventCallback<WorkLogResponseDto> OnDeleteRequest { get; set; }

    // Riproduce esattamente il comportamento originale: chiude prima la modale
    // di modifica, poi apre la conferma di eliminazione sullo stesso worklog.
    private async Task HandleDeleteClick()
    {
        var source = EditSource;
        await OnClose.InvokeAsync();
        if (source is not null)
            await OnDeleteRequest.InvokeAsync(source);
    }
}
