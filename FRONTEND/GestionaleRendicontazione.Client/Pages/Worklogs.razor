@page "/worklogs"
@attribute [Authorize]

<PageTitle>I miei Worklog</PageTitle>

<Row>
    <Column ColumnSize="ColumnSize.Is12.OnDesktop.Is12.OnMobile">
        <Card>
            <CardBody>
                <CardTitle>Elenco Worklog</CardTitle>
                <Paragraph>Visualizza i tuoi lavori recenti e gestisci gli inserimenti.</Paragraph>
                <Table>
                    <thead>
                        <tr>
                            <th>Data</th>
                            <th>Progetto</th>
                            <th>Ore</th>
                            <th>Stato</th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr>
                            <td>16/07/2026</td>
                            <td>CRM Aziendale</td>
                            <td>8</td>
                            <td>Approvato</td>
                        </tr>
                        <tr>
                            <td>15/07/2026</td>
                            <td>ERP Gestionale</td>
                            <td>6</td>
                            <td>In lavorazione</td>
                        </tr>
                    </tbody>
                </Table>
            </CardBody>
        </Card>
    </Column>
</Row>
