@page "/change-password"
@attribute [Authorize]
@inject AuthService AuthService
@inject NavigationManager NavigationManager

<PageTitle>Cambio password</PageTitle>

<div class="auth-page">
    <div class="auth-card">
        <div class="auth-brand">
            <div class="auth-brand-icon"><i class="bi bi-key"></i></div>
            <div class="auth-brand-title">WORKLOG<small>MANAGER</small></div>
        </div>

        <div class="auth-welcome">
            <h2>Cambio password obbligatorio</h2>
            <p>Devi impostare una nuova password prima di continuare.</p>
        </div>

        @if (!string.IsNullOrEmpty(_errorMessage))
        {
            <Alert Color="Color.Danger" Visible="true">
                @_errorMessage
            </Alert>
        }

        <EditForm Model="_model" OnValidSubmit="HandleSubmitAsync">
            <div class="mb-3">
                <label class="form-label">Password attuale</label>
                <div class="auth-input-group">
                    <i class="bi bi-lock"></i>
                    <InputText @bind-Value="_model.CurrentPassword" type="password" placeholder="Password attuale" />
                </div>
            </div>

            <div class="mb-3">
                <label class="form-label">Nuova password</label>
                <div class="auth-input-group">
                    <i class="bi bi-lock-fill"></i>
                    <InputText @bind-Value="_model.NewPassword" type="password" placeholder="Nuova password (min. 6 caratteri)" />
                </div>
            </div>

            <div class="mb-3">
                <label class="form-label">Conferma nuova password</label>
                <div class="auth-input-group">
                    <i class="bi bi-lock-fill"></i>
                    <InputText @bind-Value="_confirmPassword" type="password" placeholder="Ripeti la nuova password" />
                </div>
            </div>

            <Button Color="Color.Primary" Type="ButtonType.Submit" Class="mt-2 w-100 btn-genera" Disabled="_isSaving">
                @if (_isSaving)
                {
                    <span><i class="bi bi-arrow-repeat spin"></i> Salvataggio...</span>
                }
                else
                {
                    <span>Cambia password</span>
                }
            </Button>
        </EditForm>
    </div>
</div>

@code {
    private ChangePasswordRequestDto _model = new();
    private string _confirmPassword = string.Empty;
    private string? _errorMessage;
    private bool _isSaving;

    private async Task HandleSubmitAsync()
    {
        _errorMessage = null;

        if (string.IsNullOrWhiteSpace(_model.CurrentPassword) || string.IsNullOrWhiteSpace(_model.NewPassword))
        {
            _errorMessage = "Compila tutti i campi.";
            return;
        }
        if (_model.NewPassword != _confirmPassword)
        {
            _errorMessage = "Le due password non coincidono.";
            return;
        }

        _isSaving = true;
        try
        {
            var result = await AuthService.ChangePasswordAsync(_model.CurrentPassword, _model.NewPassword);
            if (!result.IsSuccess)
            {
                _errorMessage = result.ToUserMessage("Impossibile cambiare la password. Riprova.");
                return;
            }

            NavigationManager.NavigateTo("/", forceLoad: false);
        }
        finally
        {
            _isSaving = false;
        }
    }
}
