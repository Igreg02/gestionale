@page "/report"
@attribute [Authorize]

<PageTitle>Report</PageTitle>

<Row>
    <Column ColumnSize="ColumnSize.Is12.OnDesktop.Is12.OnMobile">
        <Card>
            <CardBody>
                <CardTitle>Report</CardTitle>
                <Paragraph>Genera report sui worklog per periodo e dipendente.</Paragraph>
                <div class="mb-3">
                    <label class="form-label">Periodo da</label>
                    <InputDate @bind-Value="_dateFrom" class="form-control" />
                </div>
                <div class="mb-3">
                    <label class="form-label">Periodo a</label>
                    <InputDate @bind-Value="_dateTo" class="form-control" />
                </div>
                <div class="mb-3">
                    <label class="form-label">Dipendente</label>
                    <InputSelect @bind-Value="_selectedEmployee" class="form-select">
                        <option value="me">Me (Mario Rossi)</option>
                    </InputSelect>
                </div>
                <Button Color="Color.Primary">Genera Report</Button>
            </CardBody>
        </Card>
    </Column>
</Row>

@code {
    private DateTime _dateFrom = DateTime.Today.AddDays(-7);
    private DateTime _dateTo = DateTime.Today;
    private string _selectedEmployee = "me";
}
