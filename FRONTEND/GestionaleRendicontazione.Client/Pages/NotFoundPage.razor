@page "/404"

<PageTitle>Pagina non trovata</PageTitle>

<div class="error-page">
    <div class="error-page-icon bg-light-blue">
        <i class="bi bi-compass text-blue"></i>
    </div>
    <h2 class="error-page-title">404 — Pagina non trovata</h2>
    <p class="error-page-text">La pagina richiesta non esiste o è stata spostata.</p>
    <a href="/" class="btn btn-primary btn-genera px-4">Torna alla Dashboard</a>
</div>
