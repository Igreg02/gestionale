@page "/profile"
@attribute [Authorize]

<PageTitle>Profilo</PageTitle>

<Row>
    <Column ColumnSize="ColumnSize.Is12.OnDesktop.Is12.OnMobile">
        <Card>
            <CardBody>
                <CardTitle>Profilo utente</CardTitle>
                <div class="d-flex justify-content-between align-items-center mb-3">
                    <div>
                        <Heading Size="HeadingSize.Is5">Mario Rossi</Heading>
                        <Paragraph>Admin / Dipendente</Paragraph>
                    </div>
                </div>

                <div class="mb-3">
                    <label class="form-label">Username</label>
                    <input class="form-control" value="mrossi" readonly />
                </div>
                <div class="mb-3">
                    <label class="form-label">Nome completo</label>
                    <input class="form-control" value="Mario Rossi" readonly />
                </div>
            </CardBody>
        </Card>
    </Column>
</Row>
