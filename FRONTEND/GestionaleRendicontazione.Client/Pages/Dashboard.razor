@page "/dashboard"
@attribute [Authorize]

<PageTitle>Dashboard</PageTitle>

<Row Class="mb-4">
    <Column ColumnSize="ColumnSize.Is12.OnDesktop.Is12.OnMobile">
        <Heading Size="HeadingSize.Is3">Dashboard</Heading>
        <Paragraph>Benvenuto nel tuo cruscotto personale. Qui puoi monitorare i worklog e accedere alle funzionalità principali.</Paragraph>
    </Column>
</Row>

<Row>
    <Column ColumnSize="ColumnSize.Is8.OnDesktop.Is12.OnMobile">
        <Card>
            <CardBody>
                <CardTitle>Attività recenti</CardTitle>
                <div class="d-flex flex-wrap gap-3">
                    <Card Class="flex-grow-1" Style="min-width: 200px; max-width: 260px;">
                        <CardBody>
                            <div class="d-flex justify-content-between align-items-center mb-3">
                                <Heading Size="HeadingSize.Is6">Worklog #1001</Heading>
                                <span class="badge bg-primary">8 ore</span>
                            </div>
                            <div>16/07/2026 · Sviluppo API</div>
                            <div class="mt-2 text-primary">Visualizza &rarr;</div>
                        </CardBody>
                    </Card>
                    <Card Class="flex-grow-1" Style="min-width: 200px; max-width: 260px;">
                        <CardBody>
                            <div class="d-flex justify-content-between align-items-center mb-3">
                                <Heading Size="HeadingSize.Is6">Worklog #1002</Heading>
                                <span class="badge bg-secondary">6 ore</span>
                            </div>
                            <div>15/07/2026 · Analisi</div>
                            <div class="mt-2 text-primary">Visualizza &rarr;</div>
                        </CardBody>
                    </Card>
                    <Card Class="flex-grow-1" Style="min-width: 200px; max-width: 260px;">
                        <CardBody>
                            <div class="d-flex justify-content-between align-items-center mb-3">
                                <Heading Size="HeadingSize.Is6">Worklog #1003</Heading>
                                <span class="badge bg-warning text-dark">4 ore</span>
                            </div>
                            <div>14/07/2026 · Review</div>
                            <div class="mt-2 text-primary">Visualizza &rarr;</div>
                        </CardBody>
                    </Card>
                </div>
            </CardBody>
        </Card>
    </Column>
</Row>

<Row Class="mt-4">
    <Column ColumnSize="ColumnSize.Is6.OnDesktop.Is12.OnMobile">
        <Card>
            <CardBody>
                <CardTitle>Genera report</CardTitle>
                <div class="mb-3">
                    <label class="form-label">Periodo da</label>
                    <InputDate @bind-Value="_dateFrom" class="form-control" />
                </div>
                <div class="mb-3">
                    <label class="form-label">Periodo a</label>
                    <InputDate @bind-Value="_dateTo" class="form-control" />
                </div>
                <div class="mb-3">
                    <label class="form-label">Dipendente</label>
                    <InputSelect @bind-Value="_selectedEmployee" class="form-select">
                        <option value="me">Me (Mario Rossi)</option>
                    </InputSelect>
                </div>
                <Button Color="Color.Primary">Genera Report</Button>
            </CardBody>
        </Card>
    </Column>
    <Column ColumnSize="ColumnSize.Is6.OnDesktop.Is12.OnMobile">
        <Card>
            <CardBody>
                <CardTitle>Progetti</CardTitle>
                <Table>
                    <thead>
                        <tr>
                            <th>Nome</th>
                            <th>Tipo</th>
                            <th>Stato</th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr>
                            <td>CRM Aziendale</td>
                            <td>Interno</td>
                            <td><span class="badge bg-success">Attivo</span></td>
                        </tr>
                        <tr>
                            <td>ERP Gestionale</td>
                            <td>Cliente</td>
                            <td><span class="badge bg-success">Attivo</span></td>
                        </tr>
                    </tbody>
                </Table>
            </CardBody>
        </Card>
    </Column>
</Row>

@code {
    private DateTime _dateFrom = DateTime.Today.AddDays(-7);
    private DateTime _dateTo = DateTime.Today;
    private string _selectedEmployee = "me";
}
