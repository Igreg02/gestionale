@page "/admin/logs"
@attribute [Authorize(Roles = RoleNames.Admin)]
@implements IDisposable
@using GestionaleRendicontazione.Client.Pages.Admin.Components.Logs
@inject LogApiClient LogApiClient

<PageTitle>Logs</PageTitle>

<div class="container-fluid px-4">

    <div class="admin-toolbar flex-wrap gap-3">
        <div>
            <h2 class="dashboard-title mb-1">Log applicativi</h2>
            <p class="dashboard-subtitle mb-0">Consultazione dei log di sistema (sola lettura)</p>
        </div>

        <div class="d-flex align-items-center gap-2">
            <div class="worklog-search m-0" style="position: relative; min-width: 260px;">
                <i class="bi bi-search"></i>
                <input type="text" placeholder="Messaggio, path, utente..." value="@_search"
                       @oninput="OnSearchInput" />
                @if (!string.IsNullOrEmpty(_search))
                {
                    <button type="button" class="worklog-search-clear" title="Cancella ricerca" @onclick="ClearSearch">
                        <i class="bi bi-x-circle-fill"></i>
                    </button>
                }
            </div>

            <div class="filter-menu" style="position: relative;">
                <button type="button"
                        class="btn btn-primary filter-toggle-btn d-inline-flex align-items-center gap-1 py-2 px-3"
                        @onclick="ToggleFilterPanel"
                        style="height: 46px; background-color: var(--primary-blue); color: #fff; border: none; border-radius: 10px; font-weight: 600; font-size: 0.95rem;">
                    <i class="bi bi-funnel@(HasActiveFilters ? "-fill" : "")"></i>
                    <span>Filtro</span>
                    @if (HasActiveFilters)
                    {
                        <span class="filter-badge" style="background-color: #fff;"></span>
                    }
                </button>

                @if (_filterPanelOpen)
                {
                    <div class="filter-menu-backdrop" @onclick="() => _filterPanelOpen = false"></div>
                    <div class="filter-menu-dropdown" @onclick:stopPropagation="true">
                        <div class="row g-3">
                            <div class="col-6">
                                <label class="form-label text-muted fw-bold small">Dal</label>
                                <input type="date" class="form-control custom-input" value="@_dateFrom" @onchange="OnDateFromChanged" />
                            </div>
                            <div class="col-6">
                                <label class="form-label text-muted fw-bold small">Al</label>
                                <input type="date" class="form-control custom-input" value="@_dateTo" @onchange="OnDateToChanged" />
                            </div>
                            <div class="col-12">
                                <label class="form-label text-muted fw-bold small">Livello</label>
                                <select class="form-select custom-input" @bind="_level">
                                    <option value="">Tutti</option>
                                    <option value="Information">Information</option>
                                    <option value="Warning">Warning</option>
                                    <option value="Error">Error</option>
                                    <option value="Fatal">Fatal</option>
                                </select>
                            </div>
                            <div class="col-12">
                                <label class="form-label text-muted fw-bold small">Metodo</label>
                                <select class="form-select custom-input" @bind="_method">
                                    <option value="">Tutti</option>
                                    <option value="GET">GET</option>
                                    <option value="POST">POST</option>
                                    <option value="PUT">PUT</option>
                                    <option value="DELETE">DELETE</option>
                                    <option value="PATCH">PATCH</option>
                                </select>
                            </div>
                        </div>
                        <div class="d-flex gap-2 mt-3">
                            <button class="btn btn-primary flex-fill d-flex align-items-center justify-content-center gap-1"
                                    @onclick="ApplyFiltersAsync"
                                    style="background-color: var(--primary-blue); border: none; height: 40px; border-radius: 8px;">
                                <i class="bi bi-funnel"></i> Filtra
                            </button>
                            <button class="btn btn-outline-secondary" title="Reimposta filtri"
                                    @onclick="ResetFiltersAsync" style="height: 40px; border-radius: 8px;">
                                <i class="bi bi-arrow-counterclockwise"></i>
                            </button>
                        </div>
                    </div>
                }
            </div>

            <button class="btn btn-outline-secondary d-inline-flex align-items-center gap-1" style="height: 46px; border-radius: 10px;"
                    @onclick="() => LoadAsync()" disabled="@_loading" title="Aggiorna">
                <i class="bi bi-arrow-repeat @(_loading ? "spin" : "")"></i>
            </button>
        </div>
    </div>

    @if (_loading)
    {
        <div class="worklog-status-panel">
            <i class="bi bi-arrow-repeat spin"></i> Caricamento log...
        </div>
    }
    else if (_errorMessage is not null)
    {
        <Alert Color="Color.Danger" Visible="true" class="d-flex align-items-center justify-content-between flex-wrap gap-2">
            <span><i class="bi bi-exclamation-triangle me-1"></i> @_errorMessage</span>
            <button type="button" class="btn btn-sm btn-outline-light" @onclick="() => LoadAsync()" disabled="@_loading">
                <i class="bi bi-arrow-clockwise"></i> Riprova
            </button>
        </Alert>
    }
    else
    {
        <LogTable Items="_items" OnRowClick="OpenView" />

        <div class="d-flex align-items-center justify-content-between flex-wrap gap-2 mt-3">
            <span class="text-muted small">
                @if (_totalCount == 0)
                {
                    <text>Nessun risultato</text>
                }
                else
                {
                    <text>Risultati @_firstRowIndex&ndash;@_lastRowIndex di @_totalCount</text>
                }
            </span>

            @if (_totalPages > 1)
            {
                <div class="d-flex align-items-center gap-2">
                    <button class="btn btn-outline-secondary btn-sm" disabled="@(_page <= 1)" @onclick="() => GoToPageAsync(_page - 1)">
                        <i class="bi bi-chevron-left"></i> Precedente
                    </button>
                    <span class="text-muted small">Pagina @_page di @_totalPages</span>
                    <button class="btn btn-outline-secondary btn-sm" disabled="@(_page >= _totalPages)" @onclick="() => GoToPageAsync(_page + 1)">
                        Successiva <i class="bi bi-chevron-right"></i>
                    </button>
                </div>
            }
        </div>
    }
</div>

<LogViewModal Open="_viewOpen" Log="_viewTarget" OnClose="CloseView" />
