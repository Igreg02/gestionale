@page "/admin/dipendenti"
@attribute [Authorize(Roles = RoleNames.Admin)]
@inject EmployeeApiClient EmployeeApiClient

<PageTitle>Dipendenti</PageTitle>

<div class="container-fluid px-4">

    <div class="admin-toolbar">
        <div>
            <h2 class="dashboard-title mb-1">Dipendenti</h2>
            <p class="dashboard-subtitle mb-0">Tecnici che rendicontano le ore. La creazione avviene tramite registrazione (Login → Registra nuovo dipendente).</p>
        </div>
    </div>

    @if (_loading)
    {
        <div class="worklog-status-panel">
            <i class="bi bi-arrow-repeat spin"></i> Caricamento dipendenti...
        </div>
    }
    else if (_errorMessage is not null)
    {
        <Alert Color="Color.Danger" Visible="true">@_errorMessage</Alert>
    }
    else
    {
        <div class="admin-panel">
            <table class="admin-table">
                <thead>
                    <tr>
                        <th>Username</th>
                        <th>Nome</th>
                        <th>Cognome</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    @if (_employees.Count == 0)
                    {
                        <tr class="admin-empty-row">
                            <td colspan="4">Nessun dipendente registrato.</td>
                        </tr>
                    }
                    else
                    {
                        @foreach (var employee in _employees)
                        {
                            <tr>
                                <td class="fw-semibold">@employee.Username</td>
                                <td class="text-muted">@employee.FirstName</td>
                                <td class="text-muted">@employee.LastName</td>
                                <td>
                                    <div class="admin-table-actions">
                                        <button class="admin-row-icon-btn" title="Modifica" @onclick="() => OpenEditModal(employee)">
                                            <i class="bi bi-pencil-square"></i>
                                        </button>
                                        <button class="admin-row-icon-btn is-danger" title="Elimina" @onclick="() => ConfirmDelete(employee)">
                                            <i class="bi bi-trash3"></i>
                                        </button>
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    }
</div>

@* ====================== MODALE MODIFICA DIPENDENTE ====================== *@
@if (_formModalOpen && _formModel is not null)
{
    <div class="custom-modal-backdrop" @onclick="CloseFormModal">
        <div class="wl-modal-card" style="width:480px;" @onclick:stopPropagation="true">

            <div class="wl-modal-header">
                <span class="wl-modal-label">MODIFICA DIPENDENTE</span>
                <div class="d-flex align-items-center gap-3">
                    <button class="wl-back-btn" @onclick="CloseFormModal" aria-label="Chiudi">
                        <i class="bi bi-arrow-left"></i>
                    </button>
                    <span class="wl-modal-title">Modifica dipendente</span>
                </div>
            </div>

            @if (_modalError is not null)
            {
                <div class="alert alert-danger py-2 px-3 mx-0 mb-0" style="font-size:0.88rem; border-radius:0; margin-top:-1px;">
                    <i class="bi bi-exclamation-triangle me-1"></i> @_modalError
                </div>
            }

            <div class="wl-modal-body" style="display:block; padding:1.5rem;">
                <div class="wl-field-row">
                    <label class="wl-field-label">Username</label>
                    <input class="wl-field-input" @bind="_formModel.Username" placeholder="Username" />
                </div>
                <div class="wl-field-row">
                    <label class="wl-field-label">Nome</label>
                    <input class="wl-field-input" @bind="_formModel.FirstName" placeholder="Nome" />
                </div>
                <div class="wl-field-row">
                    <label class="wl-field-label">Cognome</label>
                    <input class="wl-field-input" @bind="_formModel.LastName" placeholder="Cognome" />
                </div>
            </div>

            <div class="wl-modal-footer">
                <div></div>
                <div class="d-flex gap-2">
                    <button class="wl-btn-cancel" @onclick="CloseFormModal" disabled="@_isSaving">Annulla</button>
                    <button class="wl-btn-save" @onclick="SaveFormAsync" disabled="@_isSaving">
                        @if (_isSaving)
                        {
                            <i class="bi bi-arrow-repeat spin"></i> <span>Salvataggio...</span>
                        }
                        else
                        {
                            <i class="bi bi-check2"></i> <span>Salva</span>
                        }
                    </button>
                </div>
            </div>

        </div>
    </div>
}

@* ====================== MODALE CONFERMA ELIMINA ====================== *@
@if (_deleteModalOpen && _deleteTarget is not null)
{
    <div class="custom-modal-backdrop" @onclick="CloseDeleteModal">
        <div class="wl-modal-card" style="max-width:440px;" @onclick:stopPropagation="true">

            <div class="wl-modal-header">
                <span class="wl-modal-label" style="color:#dc2626;">ELIMINA DIPENDENTE</span>
                <div class="d-flex align-items-center gap-3">
                    <button class="wl-back-btn" @onclick="CloseDeleteModal" aria-label="Chiudi">
                        <i class="bi bi-arrow-left"></i>
                    </button>
                    <span class="wl-modal-title">Conferma eliminazione</span>
                </div>
            </div>

            <div class="wl-modal-body" style="display:block; padding:1.5rem;">
                <p class="mb-2" style="font-size:0.95rem;">Stai per eliminare il dipendente:</p>
                <div style="background:var(--bg-light); border-radius:10px; padding:0.75rem 1rem; margin-bottom:0.75rem;">
                    <strong>@_deleteTarget.Username</strong>
                    <span class="ms-2 text-muted" style="font-size:0.85rem;">@_deleteTarget.FullName</span>
                </div>
                @if (_modalError is not null)
                {
                    <div class="alert alert-danger py-2 px-3 mb-2" style="font-size:0.88rem; border-radius:10px;">
                        <i class="bi bi-exclamation-triangle me-1"></i> @_modalError
                    </div>
                }
                <p class="text-muted mb-0" style="font-size:0.88rem;">Questa operazione non può essere annullata. Se il dipendente ha worklog collegati, l'eliminazione potrebbe non essere consentita dal backend.</p>
            </div>

            <div class="wl-modal-footer">
                <div></div>
                <div class="d-flex gap-2">
                    <button class="wl-btn-cancel" @onclick="CloseDeleteModal" disabled="@_isSaving">Annulla</button>
                    <button class="wl-btn-delete wl-btn-delete--solid" @onclick="ExecuteDeleteAsync" disabled="@_isSaving">
                        @if (_isSaving)
                        {
                            <i class="bi bi-arrow-repeat spin"></i> <span>Eliminazione...</span>
                        }
                        else
                        {
                            <i class="bi bi-trash3 me-1"></i> <span>Conferma elimina</span>
                        }
                    </button>
                </div>
            </div>

        </div>
    </div>
}

@code {
    private bool _loading = true;
    private string? _errorMessage;
    private List<EmployeeResponse> _employees = new();

    private bool _formModalOpen;
    private Guid _editingId;
    private EmployeeFormModel? _formModel;

    private bool _deleteModalOpen;
    private EmployeeResponse? _deleteTarget;

    private bool _isSaving;
    private string? _modalError;

    protected override async Task OnInitializedAsync() => await LoadAsync();

    private async Task LoadAsync()
    {
        _loading = true;
        _errorMessage = null;
        StateHasChanged();

        try
        {
            _employees = (await EmployeeApiClient.GetAllAsync()).OrderBy(e => e.Username).ToList();
        }
        catch (Exception ex)
        {
            Console.Error.WriteLine($"Errore nel recupero dei dipendenti: {ex}");
            _errorMessage = "Impossibile recuperare i dipendenti dal server. Riprova più tardi.";
        }
        finally
        {
            _loading = false;
        }
    }

    private void OpenEditModal(EmployeeResponse employee)
    {
        _editingId = employee.Id;
        _formModel = new EmployeeFormModel
        {
            Username = employee.Username,
            FirstName = employee.FirstName,
            LastName = employee.LastName,
        };
        _modalError = null;
        _formModalOpen = true;
    }

    private void CloseFormModal()
    {
        _formModalOpen = false;
        _formModel = null;
        _modalError = null;
    }

    private async Task SaveFormAsync()
    {
        if (_formModel is null) return;
        if (string.IsNullOrWhiteSpace(_formModel.Username)) { _modalError = "Lo username è obbligatorio."; return; }
        if (string.IsNullOrWhiteSpace(_formModel.FirstName)) { _modalError = "Il nome è obbligatorio."; return; }
        if (string.IsNullOrWhiteSpace(_formModel.LastName)) { _modalError = "Il cognome è obbligatorio."; return; }

        _isSaving = true;
        _modalError = null;

        try
        {
            var result = await EmployeeApiClient.UpdateAsync(_editingId, new EmployeeUpdateRequest
            {
                Username = _formModel.Username,
                FirstName = _formModel.FirstName,
                LastName = _formModel.LastName,
            });
            if (!result.IsSuccess) { _modalError = FormatError(result.ValidationErrors, result.ErrorMessage); return; }

            var idx = _employees.FindIndex(e => e.Id == _editingId);
            if (idx >= 0) _employees[idx] = result.Data!;

            _employees = _employees.OrderBy(e => e.Username).ToList();
            CloseFormModal();
        }
        catch (Exception ex)
        {
            Console.Error.WriteLine($"Errore nel salvataggio del dipendente: {ex}");
            _modalError = "Errore di rete. Riprova più tardi.";
        }
        finally
        {
            _isSaving = false;
        }
    }

    private void ConfirmDelete(EmployeeResponse employee)
    {
        _deleteTarget = employee;
        _modalError = null;
        _deleteModalOpen = true;
    }

    private void CloseDeleteModal()
    {
        _deleteModalOpen = false;
        _deleteTarget = null;
        _modalError = null;
    }

    private async Task ExecuteDeleteAsync()
    {
        if (_deleteTarget is null) return;

        _isSaving = true;
        _modalError = null;

        try
        {
            var result = await EmployeeApiClient.DeleteAsync(_deleteTarget.Id);
            if (!result.IsSuccess) { _modalError = FormatError(result.ValidationErrors, result.ErrorMessage); return; }

            _employees.RemoveAll(e => e.Id == _deleteTarget.Id);
            CloseDeleteModal();
        }
        catch (Exception ex)
        {
            Console.Error.WriteLine($"Errore nell'eliminazione del dipendente: {ex}");
            _modalError = "Errore di rete. Riprova più tardi.";
        }
        finally
        {
            _isSaving = false;
        }
    }

    private static string FormatError(Dictionary<string, string[]> validationErrors, string? errorMessage)
    {
        if (validationErrors.Count > 0)
            return string.Join(" ", validationErrors.SelectMany(kv => kv.Value));
        return errorMessage ?? "Si è verificato un errore imprevisto.";
    }

    private sealed class EmployeeFormModel
    {
        public string Username { get; set; } = string.Empty;
        public string FirstName { get; set; } = string.Empty;
        public string LastName { get; set; } = string.Empty;
    }
}
