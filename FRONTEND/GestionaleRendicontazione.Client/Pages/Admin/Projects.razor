@page "/admin/progetti"
@attribute [Authorize(Roles = RoleNames.Admin)]
@using GestionaleRendicontazione.Client.Pages.Admin.Components._Generic
@inject ProjectApiClient ProjectApiClient
@inject CompanyApiClient CompanyApiClient
@inject FilterStateService FilterState

<PageTitle>Progetti</PageTitle>

<div class="container-fluid px-4">

    <div class="admin-toolbar">
        <div>
            <h2 class="dashboard-title mb-1">Progetti</h2>
            <p class="dashboard-subtitle mb-0">Progetti collegati alle aziende cliente/interne</p>
        </div>
        <button class="btn btn-primary btn-genera d-inline-flex align-items-center gap-2 px-4" @onclick="OpenCreateModal" disabled="@(_companies.Count == 0)">
            <i class="bi bi-plus-lg"></i> Nuovo progetto
        </button>
    </div>

    @if (Crud.IsLoading)
    {
        <div class="worklog-status-panel">
            <i class="bi bi-arrow-repeat spin"></i> Caricamento progetti...
        </div>
    }
    else if (Crud.ErrorMessage is not null)
    {
        <Alert Color="Color.Danger" Visible="true" class="d-flex align-items-center justify-content-between flex-wrap gap-2">
            <span><i class="bi bi-exclamation-triangle me-1"></i> @Crud.ErrorMessage</span>
            <button type="button" class="btn btn-sm btn-outline-light" @onclick="() => LoadAsync()" disabled="@Crud.IsLoading">
                <i class="bi bi-arrow-clockwise"></i> Riprova
            </button>
        </Alert>
    }
    else
    {
        @if (_companies.Count == 0)
        {
            <Alert Color="Color.Warning" Visible="true">
                Devi creare almeno un'azienda prima di poter aggiungere un progetto.
            </Alert>
        }

        <NamedItemTable TItem="ProjectResponse"
                        Items="_projects"
                        Colspan="3"
                        EmptyMessage="Nessun progetto registrato.">
            <HeaderContent>
                <th>Nome progetto</th>
                <th>Azienda</th>
                <th></th>
            </HeaderContent>
            <RowContent>
                <td class="fw-semibold">@context.Name</td>
                <td class="text-muted">@context.CompanyName</td>
                <td>
                    <div class="admin-table-actions">
                        <button class="admin-row-icon-btn" title="Modifica" @onclick="() => OpenEditModal(context)">
                            <i class="bi bi-pencil-square"></i>
                        </button>
                        <button class="admin-row-icon-btn is-danger" title="Elimina" @onclick="() => ConfirmDelete(context)">
                            <i class="bi bi-trash3"></i>
                        </button>
                    </div>
                </td>
            </RowContent>
        </NamedItemTable>
    }
</div>

<NamedItemFormModal TForm="ProjectFormModel"
                    Open="_formModalOpen"
                    IsEditing="_isEditing"
                    Model="_formModel"
                    Width="480px"
                    HeaderLabel="@(_isEditing ? "MODIFICA PROGETTO" : "NUOVO PROGETTO")"
                    ModalTitle="@(_isEditing ? "Modifica progetto" : "Nuovo progetto")"
                    ModalError="@Crud.ModalError"
                    IsSaving="Crud.IsSaving"
                    OnClose="CloseFormModal"
                    OnSave="SaveFormAsync">
    <ChildContent Context="form">
        <div class="wl-field-row">
            <label class="wl-field-label">Nome</label>
            <input class="wl-field-input" @bind="form.Name" placeholder="Nome progetto" />
        </div>
        <div class="wl-field-row">
            <label class="wl-field-label">Azienda</label>
            <select class="wl-field-input" @bind="form.IdCompany">
                <option value="@Guid.Empty">-- Seleziona --</option>
                @foreach (var company in _companies)
                {
                    <option value="@company.Id">@company.Name</option>
                }
            </select>
        </div>
    </ChildContent>
</NamedItemFormModal>

<NamedItemDeleteModal TItem="ProjectResponse"
                      Open="_deleteModalOpen"
                      Target="_deleteTarget"
                      HeaderLabel="ELIMINA PROGETTO"
                      ModalTitle="Conferma eliminazione"
                      LeadingText="Stai per eliminare il progetto:"
                      WarningText="Questa operazione non può essere annullata. Se il progetto ha worklog collegati, l'eliminazione potrebbe non essere consentita dal backend."
                      ModalError="@Crud.ModalError"
                      IsSaving="Crud.IsSaving"
                      OnClose="CloseDeleteModal"
                      OnConfirm="ExecuteDeleteAsync">
    <TargetContent Context="item">
        <strong>@item.Name</strong>
        <span class="ms-2 text-muted" style="font-size:0.85rem;">@item.CompanyName</span>
    </TargetContent>
</NamedItemDeleteModal>