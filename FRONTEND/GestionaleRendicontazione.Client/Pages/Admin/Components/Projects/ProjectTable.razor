@using GestionaleRendicontazione.Client.Services

<div class="admin-panel">
    <table class="admin-table">
        <thead>
            <tr>
                <th>Nome progetto</th>
                <th>Azienda</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @if (Projects.Count == 0)
            {
                <tr class="admin-empty-row">
                    <td colspan="3">Nessun progetto registrato.</td>
                </tr>
            }
            else
            {
                @foreach (var project in Projects)
                {
                    <tr>
                        <td class="fw-semibold">@project.Name</td>
                        <td class="text-muted">@project.CompanyName</td>
                        <td>
                            <div class="admin-table-actions">
                                <button class="admin-row-icon-btn" title="Modifica" @onclick="() => OnEdit.InvokeAsync(project)">
                                    <i class="bi bi-pencil-square"></i>
                                </button>
                                <button class="admin-row-icon-btn is-danger" title="Elimina" @onclick="() => OnDelete.InvokeAsync(project)">
                                    <i class="bi bi-trash3"></i>
                                </button>
                            </div>
                        </td>
                    </tr>
                }
            }
        </tbody>
    </table>
</div>

@code {
    [Parameter] public List<ProjectResponse> Projects { get; set; } = new();
    [Parameter] public EventCallback<ProjectResponse> OnEdit { get; set; }
    [Parameter] public EventCallback<ProjectResponse> OnDelete { get; set; }
}
