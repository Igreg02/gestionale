@using GestionaleRendicontazione.Client.Services

@if (Open && Log is not null)
{
    <div class="custom-modal-backdrop" @onclick="() => OnClose.InvokeAsync()">
        <div class="wl-modal-card" style="width:560px;" @onclick:stopPropagation="true">

            <div class="wl-modal-header">
                <span class="wl-modal-label">DETTAGLIO LOG #@Log.Id</span>
                <div class="d-flex align-items-center gap-3">
                    <button class="wl-back-btn" @onclick="() => OnClose.InvokeAsync()" aria-label="Chiudi">
                        <i class="bi bi-arrow-left"></i>
                    </button>
                    <span class="wl-modal-title">
                        Log applicativo
                        <span class="badge @LevelBadgeClass(Log.Livello) ms-2">@Log.Livello</span>
                    </span>
                </div>
            </div>

            <div class="wl-modal-body" style="display:block; padding:1.5rem;">
                <div class="wl-field-row">
                    <label class="wl-field-label">Data</label>
                    <span>@Log.Data.ToLocalTime().ToString("dd/MM/yyyy HH:mm:ss")</span>
                </div>
                <div class="wl-field-row">
                    <label class="wl-field-label">Metodo</label>
                    <span>@(string.IsNullOrWhiteSpace(Log.Metodo) ? "—" : Log.Metodo)</span>
                </div>
                <div class="wl-field-row">
                    <label class="wl-field-label">Path</label>
                    <span style="word-break: break-all;">@(string.IsNullOrWhiteSpace(Log.Path) ? "—" : Log.Path)</span>
                </div>
                <div class="wl-field-row">
                    <label class="wl-field-label">Utente</label>
                    <span>@(string.IsNullOrWhiteSpace(Log.UserId) ? "—" : Log.UserId)</span>
                </div>

                <div class="mt-3">
                    <label class="wl-field-label d-block mb-2">Messaggio</label>
                    <textarea class="wl-desc-area" style="width:100%; min-height:160px;" readonly>@Log.Messaggio</textarea>
                </div>
            </div>

            <div class="wl-modal-footer">
                <div></div>
                <div class="d-flex gap-2">
                    <button class="wl-btn-cancel" @onclick="() => OnClose.InvokeAsync()">Chiudi</button>
                </div>
            </div>

        </div>
    </div>
}

@code {
    [Parameter] public bool Open { get; set; }
    [Parameter] public LogResponse? Log { get; set; }
    [Parameter] public EventCallback OnClose { get; set; }

    private static string LevelBadgeClass(string livello) => livello switch
    {
        "Error" or "Fatal" => "bg-danger",
        "Warning" => "bg-warning text-dark",
        "Information" => "bg-info text-dark",
        "Debug" or "Verbose" => "bg-secondary",
        _ => "bg-secondary"
    };
}
