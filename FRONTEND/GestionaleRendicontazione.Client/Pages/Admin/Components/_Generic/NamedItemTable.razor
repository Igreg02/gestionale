@typeparam TItem where TItem : class

<div class="admin-panel">
    <table class="admin-table">
        <thead>
            <tr>
                @if (HeaderContent is not null)
                {
                    @HeaderContent
                }
            </tr>
        </thead>
        <tbody>
            @if (Items is null || Items.Count == 0)
            {
                <tr class="admin-empty-row">
                    <td colspan="@Colspan">@EmptyMessage</td>
                </tr>
            }
            else if (RowContent is not null)
            {
                @foreach (var item in Items)
                {
                    <tr>@RowContent(item)</tr>
                }
            }
        </tbody>
    </table>
</div>

@code {
    [Parameter, EditorRequired] public IList<TItem>? Items { get; set; }
    [Parameter, EditorRequired] public RenderFragment? HeaderContent { get; set; }
    [Parameter, EditorRequired] public RenderFragment<TItem>? RowContent { get; set; }
    [Parameter] public string EmptyMessage { get; set; } = "Nessun elemento registrato.";
    [Parameter] public int Colspan { get; set; } = 2;
}
