@typeparam TItem where TItem : class

@if (Open && Target is not null)
{
    <div class="custom-modal-backdrop" @onclick="() => OnClose.InvokeAsync()">
        <div class="wl-modal-card" style="max-width:@Width;" @onclick:stopPropagation="true">

            <div class="wl-modal-header">
                <span class="wl-modal-label" style="color:#dc2626;">@HeaderLabel</span>
                <div class="d-flex align-items-center gap-3">
                    <button class="wl-back-btn" @onclick="() => OnClose.InvokeAsync()" aria-label="Chiudi">
                        <i class="bi bi-arrow-left"></i>
                    </button>
                    <span class="wl-modal-title">@ModalTitle</span>
                </div>
            </div>

            <div class="wl-modal-body" style="display:block; padding:1.5rem;">
                <p class="mb-2" style="font-size:0.95rem;">@LeadingText</p>
                <div style="background:var(--bg-light); border-radius:10px; padding:0.75rem 1rem; margin-bottom:0.75rem;">
                    @if (TargetContent is not null)
                    {
                        @TargetContent(Target)
                    }
                </div>
                @if (ModalError is not null)
                {
                    <div class="alert alert-danger py-2 px-3 mb-2" style="font-size:0.88rem; border-radius:10px;">
                        <i class="bi bi-exclamation-triangle me-1"></i> @ModalError
                    </div>
                }
                <p class="text-muted mb-0" style="font-size:0.88rem;">@WarningText</p>
            </div>

            <div class="wl-modal-footer">
                <div></div>
                <div class="d-flex gap-2">
                    <button class="wl-btn-cancel" @onclick="() => OnClose.InvokeAsync()" disabled="@IsSaving">Annulla</button>
                    <button class="wl-btn-delete wl-btn-delete--solid" @onclick="() => OnConfirm.InvokeAsync()" disabled="@IsSaving">
                        @if (IsSaving)
                        {
                            <i class="bi bi-arrow-repeat spin"></i> <span>@DeletingLabel</span>
                        }
                        else
                        {
                            <i class="bi @Icon me-1"></i> <span>@ConfirmLabel</span>
                        }
                    </button>
                </div>
            </div>

        </div>
    </div>
}

@code {
    [Parameter, EditorRequired] public bool Open { get; set; }
    [Parameter, EditorRequired] public TItem? Target { get; set; }
    [Parameter] public string? ModalError { get; set; }
    [Parameter] public bool IsSaving { get; set; }
    [Parameter, EditorRequired] public EventCallback OnClose { get; set; }
    [Parameter, EditorRequired] public EventCallback OnConfirm { get; set; }

    [Parameter, EditorRequired] public string HeaderLabel { get; set; } = "ELIMINA";
    [Parameter, EditorRequired] public string ModalTitle { get; set; } = "Conferma eliminazione";
    [Parameter, EditorRequired] public string LeadingText { get; set; } = "Stai per eliminare:";
    [Parameter, EditorRequired] public string WarningText { get; set; } = "Questa operazione non può essere annullata.";
    [Parameter, EditorRequired] public RenderFragment<TItem>? TargetContent { get; set; }
    [Parameter] public string ConfirmLabel { get; set; } = "Conferma elimina";
    [Parameter] public string DeletingLabel { get; set; } = "Eliminazione...";
    [Parameter] public string Width { get; set; } = "440px";
    [Parameter] public string Icon { get; set; } = "bi-trash3";
}
