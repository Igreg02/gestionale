@using GestionaleRendicontazione.Client.Services

<div class="admin-panel">
    <table class="admin-table">
        <thead>
            <tr>
                <th>Username</th>
                <th>Nome</th>
                <th>Cognome</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @if (Employees.Count == 0)
            {
                <tr class="admin-empty-row">
                    <td colspan="4">Nessun dipendente registrato.</td>
                </tr>
            }
            else
            {
                @foreach (var employee in Employees)
                {
                    <tr>
                        <td class="fw-semibold">@employee.Username</td>
                        <td class="text-muted">@employee.FirstName</td>
                        <td class="text-muted">@employee.LastName</td>
                        <td>
                            <div class="admin-table-actions">
                                <button class="admin-row-icon-btn" title="Modifica" @onclick="() => OnEdit.InvokeAsync(employee)">
                                    <i class="bi bi-pencil-square"></i>
                                </button>
                                <button class="admin-row-icon-btn is-danger" title="Elimina" @onclick="() => OnDelete.InvokeAsync(employee)">
                                    <i class="bi bi-trash3"></i>
                                </button>
                            </div>
                        </td>
                    </tr>
                }
            }
        </tbody>
    </table>
</div>

@code {
    [Parameter] public List<EmployeeResponse> Employees { get; set; } = new();
    [Parameter] public EventCallback<EmployeeResponse> OnEdit { get; set; }
    [Parameter] public EventCallback<EmployeeResponse> OnDelete { get; set; }
}
