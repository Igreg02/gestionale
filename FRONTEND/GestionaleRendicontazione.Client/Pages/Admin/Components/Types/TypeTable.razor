@using GestionaleRendicontazione.Client.Services

<div class="admin-panel">
    <table class="admin-table">
        <thead>
            <tr>
                <th>Nome</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @if (Items.Count == 0)
            {
                <tr class="admin-empty-row">
                    <td colspan="2">Nessun elemento registrato.</td>
                </tr>
            }
            else
            {
                @foreach (var item in Items)
                {
                    <tr>
                        <td class="fw-semibold">@item.Name</td>
                        <td>
                            <div class="admin-table-actions">
                                <button class="admin-row-icon-btn" title="Modifica" @onclick="() => OnEdit.InvokeAsync(item)">
                                    <i class="bi bi-pencil-square"></i>
                                </button>
                                <button class="admin-row-icon-btn is-danger" title="Elimina" @onclick="() => OnDelete.InvokeAsync(item)">
                                    <i class="bi bi-trash3"></i>
                                </button>
                            </div>
                        </td>
                    </tr>
                }
            }
        </tbody>
    </table>
</div>

@code {
    [Parameter] public List<WorkTypeResponse> Items { get; set; } = new();
    [Parameter] public EventCallback<WorkTypeResponse> OnEdit { get; set; }
    [Parameter] public EventCallback<WorkTypeResponse> OnDelete { get; set; }
}
