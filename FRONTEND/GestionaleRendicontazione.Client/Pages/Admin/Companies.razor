@page "/admin/aziende"
@attribute [Authorize(Roles = RoleNames.Admin)]
@using GestionaleRendicontazione.Client.Pages.Admin.Components._Generic
@inject CompanyApiClient CompanyApiClient
@inject FilterStateService FilterState

<PageTitle>Aziende</PageTitle>

<div class="container-fluid px-4">

    <div class="admin-toolbar">
        <div>
            <h2 class="dashboard-title mb-1">Aziende</h2>
            <p class="dashboard-subtitle mb-0">Anagrafica delle società cliente/interne</p>
        </div>
        <button class="btn btn-primary btn-genera d-inline-flex align-items-center gap-2 px-4" @onclick="OpenCreateModal">
            <i class="bi bi-plus-lg"></i> Nuova azienda
        </button>
    </div>

    @if (Crud.IsLoading)
    {
        <div class="worklog-status-panel">
            <i class="bi bi-arrow-repeat spin"></i> Caricamento aziende...
        </div>
    }
    else if (Crud.ErrorMessage is not null)
    {
        <Alert Color="Color.Danger" Visible="true" class="d-flex align-items-center justify-content-between flex-wrap gap-2">
            <span><i class="bi bi-exclamation-triangle me-1"></i> @Crud.ErrorMessage</span>
            <button type="button" class="btn btn-sm btn-outline-light" @onclick="() => LoadAsync()" disabled="@Crud.IsLoading">
                <i class="bi bi-arrow-clockwise"></i> Riprova
            </button>
        </Alert>
    }
    else
    {
        <NamedItemTable TItem="CompanyResponse"
                        Items="_companies"
                        Colspan="3"
                        EmptyMessage="Nessuna azienda registrata.">
            <HeaderContent>
                <th>Nome</th>
                <th>Email</th>
                <th></th>
            </HeaderContent>
            <RowContent>
                <td class="fw-semibold">@context.Name</td>
                <td class="text-muted">@context.Email</td>
                <td>
                    <div class="admin-table-actions">
                        <button class="admin-row-icon-btn" title="Modifica" @onclick="() => OpenEditModal(context)">
                            <i class="bi bi-pencil-square"></i>
                        </button>
                        <button class="admin-row-icon-btn is-danger" title="Elimina" @onclick="() => ConfirmDelete(context)">
                            <i class="bi bi-trash3"></i>
                        </button>
                    </div>
                </td>
            </RowContent>
        </NamedItemTable>
    }
</div>

<NamedItemFormModal TForm="CompanyFormModel"
                    Open="_formModalOpen"
                    IsEditing="_isEditing"
                    Model="_formModel"
                    Width="480px"
                    HeaderLabel="@(_isEditing ? "MODIFICA AZIENDA" : "NUOVA AZIENDA")"
                    ModalTitle="@(_isEditing ? "Modifica azienda" : "Nuova azienda")"
                    ModalError="@Crud.ModalError"
                    IsSaving="Crud.IsSaving"
                    OnClose="CloseFormModal"
                    OnSave="SaveFormAsync">
    <ChildContent Context="form">
        <div class="wl-field-row">
            <label class="wl-field-label">Nome</label>
            <input class="wl-field-input" @bind="form.Name" placeholder="Ragione sociale" />
        </div>
        <div class="wl-field-row">
            <label class="wl-field-label">Email</label>
            <input class="wl-field-input" type="email" @bind="form.Email" placeholder="email@azienda.it" />
        </div>
    </ChildContent>
</NamedItemFormModal>

<NamedItemDeleteModal TItem="CompanyResponse"
                      Open="_deleteModalOpen"
                      Target="_deleteTarget"
                      HeaderLabel="ELIMINA AZIENDA"
                      ModalTitle="Conferma eliminazione"
                      LeadingText="Stai per eliminare l'azienda:"
                      WarningText="Questa operazione non può essere annullata. Se l'azienda ha progetti collegati, l'eliminazione potrebbe non essere consentita dal backend."
                      ModalError="@Crud.ModalError"
                      IsSaving="Crud.IsSaving"
                      OnClose="CloseDeleteModal"
                      OnConfirm="ExecuteDeleteAsync">
    <TargetContent Context="item">
        <strong>@item.Name</strong>
        <span class="ms-2 text-muted" style="font-size:0.85rem;">@item.Email</span>
    </TargetContent>
</NamedItemDeleteModal>