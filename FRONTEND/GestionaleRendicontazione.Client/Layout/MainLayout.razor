@inherits LayoutComponentBase
@using System.Globalization
@using GestionaleRendicontazione.Client.Services
@using GestionaleRendicontazione.Client.Layout.Components
@implements IDisposable
@inject NavigationManager NavigationManager
@inject FilterStateService FilterState
@inject LogFilterStateService LogFilterState
@inject IJSRuntime JS

<div class="app-shell @(_sidebarOpen ? "sidebar-open" : "")">

    @if (!_isChangePassword)
    {
        <AuthorizeView Roles="@RoleNames.Admin">
            <Authorized>
                <Sidebar OnNavigate="CloseSidebar" />
            </Authorized>
        </AuthorizeView>
    }

    <div class="app-sidebar-backdrop" @onclick="CloseSidebar"></div>

    @if (_lookupsLoadFailed && !_isChangePassword)
    {
        <div class="alert alert-warning d-flex align-items-center justify-content-between m-2 py-2 px-3" role="alert">
            <span><i class="bi bi-exclamation-triangle me-1"></i> Impossibile aggiornare le liste (progetti/dipendenti/stati). Riprova più tardi.</span>
            <button type="button" class="btn-close" aria-label="Chiudi" @onclick="() => _lookupsLoadFailed = false"></button>
        </div>
    }

    <div class="app-main">
        <AuthorizeView>
            <Authorized Context="outerAuth">
                <Topbar ShowBurger="_isAdmin"
                        Theme="_darkMode"
                        ThemeChanged="OnDarkModeChanged"
                        ThemeToggleMouseDown="OnThemeToggleMouseDown"
                        OnBurgerClick="ToggleSidebar"
                        OnUserMenuToggle="ToggleUserMenu"
                        OnLogoutClick="CloseUserMenu"
                        UserDisplayName="@GetDisplayName(outerAuth.User)"
                        UserInitials="@GetInitials(outerAuth.User)"
                        UserMenuOpen="_userMenuOpen">
                    @if (_isDashboard)
                    {
                        <div class="d-flex align-items-center gap-2 flex-fill mx-3" style="max-width: 700px;">
                            <SearchBar Placeholder="Cerca nei worklog..."
                                       Value="@FilterState.SearchQuery"
                                       OnInput="OnSearchInput"
                                       OnClear="ClearSearch" />

                            <div class="filter-menu" style="position: relative;">
                                <button type="button"
                                        class="btn btn-primary filter-toggle-btn d-inline-flex align-items-center gap-1 py-2 px-3"
                                        @onclick="ToggleFilterPanel"
                                        style="height: 46px; background-color: var(--primary-blue); color: #fff; border: none; border-radius: 10px; font-weight: 600; font-size: 0.95rem; transition: background 0.2s;"
                                        onmouseover="this.style.backgroundColor='var(--primary-blue-hover)'"
                                        onmouseout="this.style.backgroundColor='var(--primary-blue)'">
                                    <i class="bi bi-funnel@(FilterState.HasActiveFilters ? "-fill" : "")"></i>
                                    <span>Filtro</span>
                                    @if (FilterState.HasActiveFilters)
                                    {
                                        <span class="filter-badge" style="background-color: #fff;"></span>
                                    }
                                </button>

                                @if (FilterState.FilterPanelOpen)
                                {
                                    <div class="filter-menu-dropdown" @onclick:stopPropagation="true"
                                         style="position: absolute; right: 0; top: 54px; z-index: 1050; width: 320px; background: var(--color-white); border: 1px solid var(--border-color); border-radius: 12px; box-shadow: 0 12px 24px var(--shadow-color-dark-12); padding: 1rem;">
                                        <div class="row g-3">
                                            <div class="col-6">
                                                <label class="form-label text-muted fw-bold small">Dal</label>
                                                <input type="date" class="form-control custom-input"
                                                       value="@FilterState.FilterFromString" @oninput="OnFilterFromInput" />
                                            </div>
                                            <div class="col-6">
                                                <label class="form-label text-muted fw-bold small">Al</label>
                                                <input type="date" class="form-control custom-input" value="@FilterState.FilterToString"
                                                       @oninput="OnFilterToInput" />
                                            </div>
                                            <AuthorizeView Roles="@RoleNames.Admin">
                                                <div class="col-12">
                                                    <label class="form-label text-muted fw-bold small">Dipendente</label>
                                                    <select class="form-select custom-input" @bind="FilterState.FilterEmployeeId">
                                                        <option value="@Guid.Empty">Tutti</option>
                                                        @foreach (var emp in FilterState.Employees)
                                                        {
                                                            <option value="@emp.Id">@emp.Username</option>
                                                        }
                                                    </select>
                                                </div>
                                                <div class="col-12">
                                                    <label class="form-label text-muted fw-bold small">Progetto</label>
                                                    <select class="form-select custom-input" @bind="FilterState.FilterProjectId">
                                                        <option value="@Guid.Empty">Tutti</option>
                                                        @foreach (var proj in FilterState.Projects)
                                                        {
                                                            <option value="@proj.Id">@proj.Name</option>
                                                        }
                                                    </select>
                                                </div>
                                                <div class="col-12">
                                                    <label class="form-label text-muted fw-bold small">Stato</label>
                                                    <select class="form-select custom-input" @bind="FilterState.FilterStatusName">
                                                        <option value="">Tutti</option>
                                                        @foreach (var s in FilterState.Statuses)
                                                        {
                                                            <option value="@s.Name">@s.Name</option>
                                                        }
                                                    </select>
                                                </div>
                                            </AuthorizeView>
                                        </div>
                                        <div class="d-flex gap-2 mt-3">
                                            <button class="btn btn-primary flex-fill d-flex align-items-center justify-content-center gap-1"
                                                    @onclick="ApplyFiltersAsync"
                                                    style="background-color: var(--primary-blue); border: none; height: 40px; border-radius: 8px;">
                                                <i class="bi bi-funnel"></i> Filtra
                                            </button>
                                            <button class="btn btn-outline-secondary" title="Reimposta filtri"
                                                    @onclick="ResetFiltersAsync" style="height: 40px; border-radius: 8px;">
                                                <i class="bi bi-arrow-counterclockwise"></i>
                                            </button>
                                        </div>
                                    </div>
                                }
                            </div>
                        </div>
                    }
                    else if (_isLogs)
                    {
                        <div class="d-flex align-items-center gap-2 flex-fill mx-3" style="max-width: 700px;">
                            <SearchBar Placeholder="Messaggio, path, utente..."
                                       Value="@LogFilterState.SearchQuery"
                                       OnInput="OnLogSearchInput"
                                       OnClear="ClearLogSearch" />

                            <div class="filter-menu" style="position: relative;">
                                <button type="button"
                                        class="btn btn-primary filter-toggle-btn d-inline-flex align-items-center gap-1 py-2 px-3"
                                        @onclick="ToggleLogFilterPanel"
                                        style="height: 46px; background-color: var(--primary-blue); color: #fff; border: none; border-radius: 10px; font-weight: 600; font-size: 0.95rem; transition: background 0.2s;"
                                        onmouseover="this.style.backgroundColor='var(--primary-blue-hover)'"
                                        onmouseout="this.style.backgroundColor='var(--primary-blue)'">
                                    <i class="bi bi-funnel@(LogFilterState.HasActiveFilters ? "-fill" : "")"></i>
                                    <span>Filtro</span>
                                    @if (LogFilterState.HasActiveFilters)
                                    {
                                        <span class="filter-badge" style="background-color: #fff;"></span>
                                    }
                                </button>

                                @if (LogFilterState.FilterPanelOpen)
                                {
                                    <div class="filter-menu-dropdown" @onclick:stopPropagation="true"
                                         style="position: absolute; right: 0; top: 54px; z-index: 1050; width: 320px; background: var(--color-white); border: 1px solid var(--border-color); border-radius: 12px; box-shadow: 0 12px 24px var(--shadow-color-dark-12); padding: 1rem;">
                                        <div class="row g-3">
                                            <div class="col-6">
                                                <label class="form-label text-muted fw-bold small">Dal</label>
                                                <input type="date" class="form-control custom-input"
                                                       value="@LogFilterState.FilterFromString" @onchange="OnLogFilterFromChanged" />
                                            </div>
                                            <div class="col-6">
                                                <label class="form-label text-muted fw-bold small">Al</label>
                                                <input type="date" class="form-control custom-input"
                                                       value="@LogFilterState.FilterToString" @onchange="OnLogFilterToChanged" />
                                            </div>
                                            <div class="col-12">
                                                <label class="form-label text-muted fw-bold small">Livello</label>
                                                <select class="form-select custom-input" @bind="LogFilterState.FilterLevel">
                                                    <option value="">Tutti</option>
                                                    <option value="Information">Information</option>
                                                    <option value="Warning">Warning</option>
                                                    <option value="Error">Error</option>
                                                    <option value="Fatal">Fatal</option>
                                                </select>
                                            </div>
                                            <div class="col-12">
                                                <label class="form-label text-muted fw-bold small">Metodo</label>
                                                <select class="form-select custom-input" @bind="LogFilterState.FilterMethod">
                                                    <option value="">Tutti</option>
                                                    <option value="GET">GET</option>
                                                    <option value="POST">POST</option>
                                                    <option value="PUT">PUT</option>
                                                    <option value="DELETE">DELETE</option>
                                                    <option value="PATCH">PATCH</option>
                                                </select>
                                            </div>
                                        </div>
                                        <div class="d-flex gap-2 mt-3">
                                            <button class="btn btn-primary flex-fill d-flex align-items-center justify-content-center gap-1"
                                                    @onclick="ApplyLogFiltersAsync"
                                                    style="background-color: var(--primary-blue); border: none; height: 40px; border-radius: 8px;">
                                                <i class="bi bi-funnel"></i> Filtra
                                            </button>
                                            <button class="btn btn-outline-secondary" title="Reimposta filtri"
                                                    @onclick="ResetLogFiltersAsync" style="height: 40px; border-radius: 8px;">
                                                <i class="bi bi-arrow-counterclockwise"></i>
                                            </button>
                                        </div>
                                    </div>
                                }
                            </div>
                        </div>
                    }
                </Topbar>
            </Authorized>
        </AuthorizeView>

        <main class="app-content">
            @Body
        </main>
    </div>
</div>

@code {
    [CascadingParameter] private Task<AuthenticationState>? AuthStateTask { get; set; }

    private bool _sidebarOpen;
    private bool _userMenuOpen;
    private bool _isDashboard;
    private bool _isLogs;
    private bool _isChangePassword;
    private bool _isAdmin;
    private bool _isAuthenticated;
    // Stato del toggle dark/light. Sincronizzato con localStorage via
    // wwwroot/js/theme.js (window.gestionaleTheme). Lo script JS applica
    // già la classe .dark al <body> al boot prima di Blazor, quindi qui
    // limitiamoci a leggere lo stato per allineare il checkbox.
    private bool _darkMode;
    private bool _darkModeInitialized;
    private const int SearchDebounceMs = 300;
    private System.Timers.Timer? _searchDebounceTimer;
    private System.Timers.Timer? _logSearchDebounceTimer;
    private bool _disposed;
    private bool _lookupsLoadFailed;
    private bool _lookupsLoaded;

    protected override async Task OnInitializedAsync()
    {
        if (AuthStateTask is not null)
        {
            var authState = await AuthStateTask;
            _isAuthenticated = authState.User.Identity?.IsAuthenticated ?? false;
            _isAdmin = authState.User.IsInRole(RoleNames.Admin);
            FilterState.IsAdmin = _isAdmin;
            RedirectIfMustChangePassword(authState.User);
        }

        // Verifica l'URL iniziale all'avvio, PRIMA di caricare i lookup: sulla pagina
        // di cambio password (obbligatorio o forzato dall'admin) non servono liste
        // progetti/dipendenti/stati, quindi si evita la chiamata e il relativo alert d'errore.
        CheckCurrentLocation();

        // Ripristina i filtri persistenti (date + selezioni dropdown) da localStorage.
        // Va fatto DOPO aver determinato IsAdmin perché alcuni filtri sono significativi
        // solo per admin (es. dipendente). Se nessun filtro è salvato, l'operazione è no-op.
        await FilterState.LoadFromStorageAsync();

        // Niente lookup se non autenticati (es. pagina di login): le API sono protette
        // e la chiamata anonima darebbe solo 401 + alert "riprova" senza motivo.
        if (!_isChangePassword && _isAuthenticated)
        {
            await EnsureLookupsLoadedAsync();
        }

        FilterState.OnFiltersChanged += StateHasChanged;
        FilterState.LookupsLoadFailed += OnLookupsLoadFailed;
        LogFilterState.OnFiltersChanged += StateHasChanged;

        // Registra l'evento che intercetta i cambi di pagina/URL
        NavigationManager.LocationChanged += OnLocationChanged;
    }

    private async Task EnsureLookupsLoadedAsync()
    {
        if (_lookupsLoaded) return;
        _lookupsLoaded = true;
        await FilterState.LoadLookupsAsync();
    }

    private void OnLookupsLoadFailed()
    {
        _lookupsLoadFailed = true;
        InvokeAsync(StateHasChanged);
    }

    private async void OnLocationChanged(object? sender, Microsoft.AspNetCore.Components.Routing.LocationChangedEventArgs e)
    {
        CheckCurrentLocation();
        if (AuthStateTask is not null)
        {
            var authState = await AuthStateTask;
            _isAuthenticated = authState.User.Identity?.IsAuthenticated ?? false;
            RedirectIfMustChangePassword(authState.User);
        }

        // Se all'avvio i lookup erano stati saltati (pagina cambio password) e ora si è
        // usciti da quella pagina, li carica ora: servono a dashboard/filtri.
        if (!_isChangePassword && _isAuthenticated)
        {
            await EnsureLookupsLoadedAsync();
        }

        StateHasChanged();
    }

    /// <summary>
    /// Rimbalza su /change-password se il claim mustChangePassword del token è "true" (hint
    /// lato client, aggiornato ad ogni login/cambio password riuscito — vedi AuthService.cs).
    /// Non è la difesa: quella è sempre il backend (PasswordChangeGate, check live sul DB),
    /// questo serve solo a evitare che l'utente veda/usi la UI mentre è bloccato.
    /// </summary>
    private void RedirectIfMustChangePassword(System.Security.Claims.ClaimsPrincipal user)
    {
        if (user.FindFirst("mustChangePassword")?.Value != "true") return;

        var path = NavigationManager.ToBaseRelativePath(NavigationManager.Uri);
        if (path.StartsWith("change-password", StringComparison.OrdinalIgnoreCase)
            || path.StartsWith("logout", StringComparison.OrdinalIgnoreCase))
        {
            return;
        }

        NavigationManager.NavigateTo("/change-password", replace: true);
    }

    // Al primo render sincronizza il checkbox con lo stato persistito.
    // Lo script theme.js ha già applicato la classe .dark al <body>
    // prima del primo render di Blazor, quindi qui ci limitiamo a leggere
    // il valore e ad allineare il binding per evitare che il toggle
    // "scatti" se l'utente clicca subito.
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender && !_darkModeInitialized)
        {
            try
            {
                var stored = await JS.InvokeAsync<bool>("gestionaleTheme.get");
                if (stored != _darkMode)
                {
                    _darkMode = stored;
                    StateHasChanged();
                }
            }
            catch
            {
                // JS non ancora pronto / ambiente non browser: ignora.
            }
            _darkModeInitialized = true;
        }
    }

    // Handler invocato dal child <Topbar> quando l'utente toggle il checkbox.
    // Aggiorna lo stato locale (così al prossimo render il binding è coerente)
    // e propaga al JS che salva in localStorage + applica la classe .dark +
    // avvia l'animazione circolare dal punto del mouse (catturato su mousedown).
    private async Task OnDarkModeChanged(bool value)
    {
        _darkMode = value;
        // Coordinate del click salvate da OnThemeToggleMouseDown. Se l'utente
        // ha usato la tastiera, _lastThemeClick è null e il JS cade al centro.
        double x = 0, y = 0;
        if (_lastThemeClick is not null)
        {
            x = _lastThemeClick.ClientX;
            y = _lastThemeClick.ClientY;
        }
        try
        {
            await JS.InvokeVoidAsync("gestionaleTheme.set", _darkMode, x, y);
        }
        catch
        {
            // ambiente non browser (test/SSR): ignora.
        }
        finally
        {
            _lastThemeClick = null;
        }
    }

    // Cattura il punto del mousedown PRIMA dell'onchange, così l'animazione
    // circolare parte dal pixel esatto dove l'utente ha cliccato.
    // @onmousedown su un <input type="checkbox"> viene emesso prima del
    // toggle dello stato, quindi le coordinate sono sempre presenti quando
    // arriva l'onchange corrispondente.
    private MouseEventArgs? _lastThemeClick;
    private void OnThemeToggleMouseDown(MouseEventArgs e)
    {
        _lastThemeClick = e;
    }

    private void CheckCurrentLocation()
    {
        // Ricava il percorso relativo dell'app (es. "/" oppure "/admin/progetti")
        var relativeUri = NavigationManager.ToBaseRelativePath(NavigationManager.Uri);

        // Se la stringa è vuota o equivale a un singolo slash, l'utente è nella dashboard principale
        _isDashboard = string.IsNullOrEmpty(relativeUri) || relativeUri == "/";

        // Pagina Logs admin
        _isLogs = relativeUri.StartsWith("admin/logs", StringComparison.OrdinalIgnoreCase);

        // Pagina cambio password: niente sidebar (utente/admin bloccato finché non la cambia)
        _isChangePassword = relativeUri.StartsWith("change-password", StringComparison.OrdinalIgnoreCase);
    }

    private void OnSearchInput(ChangeEventArgs e)
    {
        FilterState.SearchQuery = e.Value?.ToString() ?? string.Empty;

        _searchDebounceTimer?.Stop();
        _searchDebounceTimer?.Dispose();
        _searchDebounceTimer = new System.Timers.Timer(SearchDebounceMs) { AutoReset = false };
        _searchDebounceTimer.Elapsed += (_, _) =>
        {
            _searchDebounceTimer?.Dispose();
            _searchDebounceTimer = null;
            // Il timer gira su un thread separato: può scattare dopo che il componente
            // è già stato smontato (navigazione via). Senza questa guardia InvokeAsync
            // rischia una race con Dispose() sul renderer già rilasciato.
            if (_disposed) return;
            InvokeAsync(() => FilterState.NotifyFiltersChanged());
        };
        _searchDebounceTimer.Start();
    }

    private void ClearSearch()
    {
        _searchDebounceTimer?.Stop();
        _searchDebounceTimer?.Dispose();
        _searchDebounceTimer = null;
        FilterState.SearchQuery = string.Empty;
        FilterState.NotifyFiltersChanged();
    }

    private void ToggleFilterPanel() => FilterState.FilterPanelOpen = !FilterState.FilterPanelOpen;

    private void OnFilterFromInput(ChangeEventArgs e) => FilterState.FilterFromString = e.Value?.ToString() ?? string.Empty;
    private void OnFilterToInput(ChangeEventArgs e) => FilterState.FilterToString = e.Value?.ToString() ?? string.Empty;

    private void ApplyFiltersAsync()
    {
        FilterState.FilterPanelOpen = false;
        FilterState.NotifyFiltersChanged();
    }

    private void ResetFiltersAsync()
    {
        var today = DateOnly.FromDateTime(DateTime.Today);
        var periodFrom = new DateOnly(today.Year, today.Month, 1);
        var periodTo = periodFrom.AddMonths(1).AddDays(-1);

        FilterState.FilterFromString = periodFrom.ToString("yyyy-MM-dd");
        FilterState.FilterToString = periodTo.ToString("yyyy-MM-dd");
        FilterState.FilterEmployeeId = Guid.Empty;
        FilterState.FilterProjectId = Guid.Empty;
        FilterState.FilterStatusName = string.Empty;
        FilterState.FilterPanelOpen = false;

        FilterState.NotifyFiltersChanged();
    }

    // ────────────────── Log filter (topbar) ──────────────────

    private void OnLogSearchInput(ChangeEventArgs e)
    {
        LogFilterState.SearchQuery = e.Value?.ToString() ?? string.Empty;

        _logSearchDebounceTimer?.Stop();
        _logSearchDebounceTimer?.Dispose();
        _logSearchDebounceTimer = new System.Timers.Timer(SearchDebounceMs) { AutoReset = false };
        _logSearchDebounceTimer.Elapsed += (_, _) =>
        {
            _logSearchDebounceTimer?.Dispose();
            _logSearchDebounceTimer = null;
            if (_disposed) return;
            InvokeAsync(() => LogFilterState.NotifyFiltersChanged());
        };
        _logSearchDebounceTimer.Start();
    }

    private void ClearLogSearch()
    {
        _logSearchDebounceTimer?.Stop();
        _logSearchDebounceTimer?.Dispose();
        _logSearchDebounceTimer = null;
        LogFilterState.SearchQuery = string.Empty;
        LogFilterState.NotifyFiltersChanged();
    }

    private void ToggleLogFilterPanel() => LogFilterState.FilterPanelOpen = !LogFilterState.FilterPanelOpen;

    private void OnLogFilterFromChanged(ChangeEventArgs e) => LogFilterState.FilterFromString = e.Value?.ToString() ?? string.Empty;
    private void OnLogFilterToChanged(ChangeEventArgs e) => LogFilterState.FilterToString = e.Value?.ToString() ?? string.Empty;

    private void ApplyLogFiltersAsync()
    {
        LogFilterState.FilterPanelOpen = false;
        LogFilterState.NotifyFiltersChanged();
    }

    private void ResetLogFiltersAsync()
    {
        var today = DateOnly.FromDateTime(DateTime.Today);
        var periodFrom = new DateOnly(today.Year, today.Month, 1);
        var periodTo = periodFrom.AddMonths(1).AddDays(-1);

        LogFilterState.FilterFromString = periodFrom.ToString("yyyy-MM-dd");
        LogFilterState.FilterToString = periodTo.ToString("yyyy-MM-dd");
        LogFilterState.FilterLevel = string.Empty;
        LogFilterState.FilterMethod = string.Empty;
        LogFilterState.FilterPanelOpen = false;

        LogFilterState.NotifyFiltersChanged();
    }

    private void ToggleSidebar() => _sidebarOpen = !_sidebarOpen;
    private void CloseSidebar() => _sidebarOpen = false;
    private void ToggleUserMenu() => _userMenuOpen = !_userMenuOpen;
    private void CloseUserMenu() => _userMenuOpen = false;

    private static string GetDisplayName(System.Security.Claims.ClaimsPrincipal user)
        => user.FindFirst("display_name")?.Value ?? user.Identity?.Name ?? string.Empty;

    private static string GetInitials(System.Security.Claims.ClaimsPrincipal user)
    {
        var name = GetDisplayName(user);
        if (string.IsNullOrWhiteSpace(name)) return "?";
        var parts = name.Split(' ', StringSplitOptions.RemoveEmptyEntries);
        return parts.Length switch
        {
            0 => "?",
            1 => parts[0][..1].ToUpperInvariant(),
            _ => $"{parts[0][..1]}{parts[^1][..1]}".ToUpperInvariant()
        };
    }

    public void Dispose()
    {
        _disposed = true;
        FilterState.OnFiltersChanged -= StateHasChanged;
        FilterState.LookupsLoadFailed -= OnLookupsLoadFailed;
        LogFilterState.OnFiltersChanged -= StateHasChanged;
        NavigationManager.LocationChanged -= OnLocationChanged;

        _searchDebounceTimer?.Stop();
        _searchDebounceTimer?.Dispose();
        _searchDebounceTimer = null;

        _logSearchDebounceTimer?.Stop();
        _logSearchDebounceTimer?.Dispose();
        _logSearchDebounceTimer = null;
    }
}
